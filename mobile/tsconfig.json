{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TS 6.0 (bumped for SDK 58, see mobile/package.json) deprecates
    // `baseUrl` ahead of removal in TS 7 -- still required here to anchor the
    // `paths` aliases below, so silence rather than restructure for now.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    // Match Metro's platform-extension resolution order for the app's
    // primary targets (iOS/Android) — without this, a bare `tsc` (this is
    // what `pnpm typecheck` runs) has no concept of RN's `.native.tsx`
    // override convention and always resolves e.g. `bottom-sheet.tsx` (the
    // web-only shim, see its own file-header comment) over
    // `bottom-sheet.native.tsx` for every import, silently type-checking
    // native screens against the wrong platform's (narrower) prop types.
    "moduleSuffixes": [".native", ""],
    "paths": {
      "@/*": ["./*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}

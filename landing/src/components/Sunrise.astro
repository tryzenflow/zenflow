---
/**
 * Port of mobile/components/brand/sunrise-backdrop.tsx, lively mode: four blobs of the logo's
 * gradient drift on X and Y out of phase over a cross-fading sunrise sweep. Decorative only.
 */
interface Props {
  /** Scales every glow (1 matches the login screen). */
  intensity?: number;
  class?: string;
}
const { intensity = 1, class: className } = Astro.props;

const BLOBS = [
  { color: "#FF6900", x: 12, y: 86, size: 95, alpha: [0.18, 0.16], dx: 150, dy: -110, ms: 7000 },
  { color: "#F0B100", x: 88, y: 62, size: 80, alpha: [0.15, 0.14], dx: -130, dy: 100, ms: 9000 },
  { color: "#D8F999", x: 90, y: 6, size: 85, alpha: [0.3, 0.12], dx: -120, dy: 130, ms: 11000 },
  { color: "#FFA66B", x: 5, y: 14, size: 70, alpha: [0.16, 0.12], dx: 130, dy: 90, ms: 8000 },
];
const LIVELY_TRAVEL = 1.8;
const LIVELY_ALPHA = 1.7;
const LIVELY_Y_RATIO = 1.37;

const hex = (a: number) =>
  Math.round(Math.min(a * intensity * LIVELY_ALPHA, 0.6) * 255)
    .toString(16)
    .padStart(2, "0");
---

<div aria-hidden="true" class:list={["sunrise pointer-events-none absolute inset-0 overflow-hidden", className]}>
  <div class="sweep sweep-a"></div>
  <div class="sweep sweep-b"></div>
  {
    BLOBS.map((b) => (
      <span
        class="blob"
        style={[
          `left:${b.x}%`,
          `top:${b.y}%`,
          `--d:${b.size}vmax`,
          `--c-light:${b.color}${hex(b.alpha[0])}`,
          `--c-dark:${b.color}${hex(b.alpha[1])}`,
          `--dx:${b.dx * LIVELY_TRAVEL}px`,
          `--dy:${b.dy * LIVELY_TRAVEL}px`,
          `--tx:${b.ms}ms`,
          `--ty:${Math.round(b.ms * LIVELY_Y_RATIO)}ms`,
          `--tp:${Math.round(b.ms * 0.6)}ms`,
        ].join(";")}
      >
        <span />
      </span>
    ))
  }
</div>

<style>
  .sweep {
    position: absolute;
    inset: 0;
  }
  .sweep-a {
    background: linear-gradient(135deg, #ffa66b33, #ffa66b00 50%, #d8f99940);
  }
  .sweep-b {
    background: linear-gradient(225deg, #f0b10040, #f0b10000 50%, #ff690028);
    animation: fade 7s ease-in-out infinite alternate;
  }
  .blob {
    --c: var(--c-light);
    position: absolute;
    width: var(--d);
    height: var(--d);
    translate: -50% -50%;
    animation: drift-x var(--tx) ease-in-out infinite alternate;
  }
  .blob > span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--c), color-mix(in srgb, var(--c) 40%, transparent) 50%, transparent);
    animation:
      drift-y var(--ty) ease-in-out infinite alternate,
      pulse var(--tp) ease-in-out infinite alternate;
  }
  @media (prefers-color-scheme: dark) {
    .blob {
      --c: var(--c-dark);
    }
    .sweep-a {
      background: linear-gradient(135deg, #ff690024, #ff690000 50%, #d8f99914);
    }
    .sweep-b {
      background: linear-gradient(225deg, #f0b10024, #f0b10000 50%, #ffa66b1c);
    }
  }
  @keyframes drift-x {
    to {
      transform: translateX(var(--dx)) scale(1.28);
    }
  }
  @keyframes drift-y {
    to {
      transform: translateY(var(--dy));
    }
  }
  @keyframes pulse {
    to {
      opacity: 0.65;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>

---
import { LANGS, type Lang, pathFor } from "../config";
import { COPY } from "../content/copy";
import SlottingDemo from "../islands/SlottingDemo";
import DownloadButton from "./DownloadButton.astro";
import Logo from "./Logo.astro";
import Sunrise from "./Sunrise.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = COPY[lang];
const words = (text: string, from = 0) => text.split(" ").map((w, i) => ({ w, i: from + i }));
const head = words(c.headline);
const accent = words(c.accent, head.length);
---

<header class="relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <Sunrise intensity={0.8} />
    <div
      class="absolute inset-0 bg-[radial-gradient(var(--color-rule)_1px,transparent_1px)] [background-size:22px_22px] [mask-image:radial-gradient(70%_60%_at_50%_30%,#000,transparent)]"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-linear-to-b from-transparent to-bg"></div>
  </div>

  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 pt-5 sm:px-6">
    <a href={pathFor(lang)} class="flex items-center gap-2.5 text-xl font-extrabold tracking-tight">
      <Logo glow />
      Zenflow
    </a>
    <div class="flex items-center gap-2">
      <div class="inline-flex gap-0.5 rounded-full border border-rule bg-card p-0.5">
        {
          LANGS.map((l) => (
            <a
              href={pathFor(l)}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? "page" : undefined}
              aria-label={COPY[l].languageName}
              class:list={[
                "min-w-10 rounded-full px-2.5 py-1 text-center text-[13px] font-semibold",
                l === lang ? "bg-fg text-bg" : "text-muted hover:text-fg",
              ]}
            >
              {COPY[l].languageShort}
            </a>
          ))
        }
      </div>
      <span class="hidden sm:inline-flex"><DownloadButton label={c.downloadShort} small /></span>
    </div>
  </nav>

  <div id="main" class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-12 pb-20 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:pt-20">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-rule bg-card/70 px-3.5 py-1.5 text-sm font-semibold text-primary-ink backdrop-blur">
        <span class="relative flex size-2">
          <span class="absolute inset-0 animate-ping rounded-full bg-accent motion-reduce:hidden"></span>
          <span class="size-2 rounded-full bg-accent"></span>
        </span>
        {c.badge}
      </span>
      <h1 class="generate mt-5 text-[clamp(2.5rem,8vw,4.5rem)] leading-[1.02] font-extrabold tracking-[-0.04em] text-balance">
        {head.map(({ w, i }) => <Fragment><span style={`--w:${i}`}>{w}</span>{" "}</Fragment>)}
        {accent.map(({ w, i }) => <Fragment><span class="text-sunrise" style={`--w:${i}`}>{w}</span>{" "}</Fragment>)}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-pretty text-muted sm:text-xl">{c.lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
        <DownloadButton label={c.download} />
        <a href="#how" class="py-3 font-semibold text-muted hover:text-fg">{c.howLink}</a>
      </div>
      <p class="mt-3 text-sm text-muted">{c.downloadNote}</p>
      <div class="mt-7 flex flex-wrap items-center gap-2 text-sm text-muted">
        {c.syncsFrom}
        {c.sources.map((s) => <span class="rounded-full border border-rule bg-card/70 px-3 py-1 font-semibold text-fg backdrop-blur">{s}</span>)}
      </div>
    </div>
    <div class="flex justify-center lg:justify-end">
      <SlottingDemo client:visible copy={c.demo} />
    </div>
  </div>
</header>

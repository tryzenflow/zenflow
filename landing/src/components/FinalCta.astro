---
import QRCode from "qrcode";
import { APK_URL, type Lang } from "../config";
import { COPY } from "../content/copy";
import DownloadButton from "./DownloadButton.astro";
import Logo from "./Logo.astro";
import Mark from "./Mark.astro";
import Sunrise from "./Sunrise.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = COPY[lang];

/** Built once at build time: no script, no request. */
const qr = await QRCode.toString(APK_URL, {
  type: "svg",
  margin: 0,
  errorCorrectionLevel: "M",
  color: { dark: "#0f0d0aff", light: "#ffffffff" },
});
---

<section class="px-4 py-24 sm:px-6">
  <div
    data-reveal
    data-lamp
    class="relative mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-ink px-6 py-14 text-white ring-1 ring-white/10 sm:px-12 sm:py-20"
  >
    <Sunrise intensity={0.5} class="opacity-60" />
    <!-- Aceternity lamp: a cone of light opens from a bright line when the panel comes into view. -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-96">
      <div class="cone"></div>
      <div class="line"></div>
    </div>
<div class="relative grid items-center gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <Logo size={56} spin glow class="mb-8" />
        <h2 class="text-[clamp(2.25rem,6vw,4rem)] leading-[1.02] font-extrabold tracking-[-0.03em] text-balance">{c.finalTitle}</h2>
        <p class="text-sunrise mt-4 text-xl font-semibold">{c.finalBody}</p>
        <div class="mt-8"><DownloadButton label={c.download} /></div>
        <h3 class="mt-12 font-semibold">{c.stepsLabel}</h3>
        <ol class="mt-3 space-y-2 text-white/80">
          {
            c.steps.map((s, i) => (
              <li class="flex gap-3">
                <span class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-accent text-xs font-extrabold text-primary-fg">
                  {i + 1}
                </span>
                {s}
              </li>
            ))
          }
        </ol>
        <p class="mt-4 max-w-lg text-sm text-white/60">{c.installNote}</p>
      </div>
      <figure class="mx-auto w-full max-w-[16rem] text-center">
        <a href={APK_URL} rel="noopener" class="block rounded-3xl bg-white p-5 shadow-[0_30px_60px_-20px_rgb(255_105_0/0.55)] transition-transform hover:-rotate-2 hover:scale-[1.02]" aria-label={c.download}>
          <Fragment set:html={qr} />
        </a>
        <figcaption class="mt-4 text-sm text-white/75">{c.qrLabel}</figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="mx-auto max-w-3xl px-4 pb-24 sm:px-6">
  <h2 data-reveal class="flex items-center gap-3 text-3xl font-extrabold tracking-tight">
    <Mark kind="searching" size={40} />
    {c.faqLabel}
  </h2>
  <div class="mt-6 divide-y divide-rule border-y border-rule">
    {
      c.faq.map((f) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
            {f.q}
            <span aria-hidden="true" class="text-xl text-primary transition-transform group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-2 text-muted">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .cone {
    position: absolute;
    inset: 0;
    background: conic-gradient(
      from 0deg at 50% 0%,
      transparent 125deg,
      rgb(255 142 62 / 0.5) 160deg,
      rgb(240 177 0 / 0.45) 200deg,
      transparent 235deg
    );
    mask-image: linear-gradient(to bottom, #000, transparent);
    transform-origin: 50% 0;
    transition:
      transform 1.1s 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 1.1s 0.2s;
  }
  .line {
    position: absolute;
    top: 0;
    left: 50%;
    width: 18rem;
    height: 2px;
    translate: -50% 0;
    background: linear-gradient(90deg, transparent, #fff085, transparent);
    box-shadow: 0 0 28px 8px rgb(255 142 62 / 0.55);
    transition: width 1.1s 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.js) [data-lamp]:not(.in) .cone {
    transform: scaleX(0.4);
    opacity: 0.3;
  }
  :global(.js) [data-lamp]:not(.in) .line {
    width: 6rem;
  }
</style>

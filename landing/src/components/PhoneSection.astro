---
import type { Lang } from "../config";
import { COPY, type SessionKind } from "../content/copy";
import ContainerScroll from "../islands/ContainerScroll";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = COPY[lang];

/** Week mock: [day, start row, rows, kind, done]. Rows are 30 minutes from 7:00. */
const WEEK: [number, number, number, SessionKind, boolean?][] = [
  [0, 2, 3, "lecture"],
  [0, 8, 2, "task", true],
  [1, 2, 3, "lecture"],
  [1, 6, 3, "lecture"],
  [1, 13, 3, "exam"],
  [1, 11, 2, "task"],
  [2, 4, 3, "lecture"],
  [2, 15, 2, "task"],
  [3, 2, 3, "lecture"],
  [3, 9, 1, "assignment"],
  [3, 18, 3, "task"],
  [4, 6, 3, "lecture"],
  [4, 12, 2, "task"],
  [5, 6, 4, "task"],
  [6, 14, 2, "task"],
];
const COLOR: Record<SessionKind, string> = {
  lecture: "var(--color-lecture)",
  exam: "var(--color-exam)",
  assignment: "var(--color-assignment)",
  task: "var(--color-task)",
};
---

<section class="mx-auto max-w-6xl px-4 pt-10 pb-24 sm:px-6">
  <div class="mx-auto max-w-2xl text-center">
    <p class="font-semibold text-primary-ink dark:text-primary">{c.shotsLabel}</p>
    <h2 class="mt-2 text-[clamp(2rem,5vw,3.25rem)] leading-tight font-extrabold tracking-tight text-balance">{c.shotsTitle}</h2>
  </div>
  <div class="mt-12">
    <ContainerScroll client:visible>
      <div
        class="mx-auto w-[min(100%,22rem)] rounded-[3rem] border-[10px] border-[#22333d] bg-bg p-3 pt-8 shadow-[0_40px_80px_-30px_rgb(47_72_88/0.55)] dark:border-[#2a3d47]"
        role="img"
        aria-label={c.week.label}
      >
        <div class="mb-2 grid grid-cols-7 gap-1 text-center text-[10px] font-semibold text-muted">
          {c.week.days.map((d, i) => <span class:list={["rounded-md py-1", i === 1 && "bg-primary text-white"]}>{d}</span>)}
        </div>
        <div class="relative grid h-[26rem] grid-cols-7 gap-1 bg-[repeating-linear-gradient(to_bottom,transparent_0_calc(1.25rem-1px),var(--color-rule)_calc(1.25rem-1px)_1.25rem)]">
          {
            Array.from({ length: 7 }, (_, day) => (
              <div class="relative">
                {WEEK.filter((b) => b[0] === day).map(([, row, rows, kind, done]) => (
                  <span
                    class:list={["block-session absolute inset-x-0 rounded-md", done && "opacity-70"]}
                    style={`top:${row * 1.25}rem;height:calc(${rows * 1.25}rem - 2px);--kind:${done ? "var(--color-done)" : COLOR[kind]}`}
                  />
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </ContainerScroll>
  </div>
</section>

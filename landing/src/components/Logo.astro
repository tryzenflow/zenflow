---
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
const id = `logo-${size}`;
---

<svg width={size} height={size} viewBox="0 0 260 260" fill="none" aria-hidden="true">
  <circle cx="130" cy="130" r="130" fill={`url(#${id})`}></circle>
  <path
    d="M220.5 51.5C220.5 51.5 172.668 65.7587 147.635 89.6235C122.602 113.488 136.249 158.201 104.912 183.517C80.2542 203.436 33 199.5 33 199.5"
    stroke="#FFD66B"
    stroke-width="24"
    stroke-linecap="round"></path>
  <defs>
    <linearGradient id={id} x1="48.5" y1="31.5" x2="222.5" y2="220.5" gradientUnits="userSpaceOnUse">
      <stop stop-color="#4652D6"></stop>
      <stop offset=".45" stop-color="#6C7BF7"></stop>
      <stop offset="1" stop-color="#5AB2FF"></stop>
    </linearGradient>
  </defs>
</svg>

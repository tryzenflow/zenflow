---
/** Sunrise mark, as mobile/components/logo.tsx: `spin` turns the curve with fading trails, `glow` breathes an orange halo. */
interface Props {
  size?: number;
  spin?: boolean;
  glow?: boolean;
  class?: string;
}
const { size = 30, spin = false, glow = false, class: className } = Astro.props;

const CURVE =
  "M220.5 51.5C220.5 51.5 172.668 65.7587 147.635 89.6235C122.602 113.488 136.249 158.201 104.912 183.517C80.2542 203.436 33 199.5 33 199.5";
const id = `zf-logo-${size}${spin ? "s" : ""}`;
/** Trails behind the lead stroke: [delay as a share of the turn, opacity, width]. */
const TRAILS: [number, number, number][] = [
  [0.11, 0.1, 14],
  [0.088, 0.18, 16],
  [0.066, 0.28, 18],
  [0.044, 0.4, 20],
  [0.022, 0.55, 22],
];
---

<span class:list={["relative inline-flex shrink-0", className]} style={`width:${size}px;height:${size}px`}>
  {
    glow && (
      <span
        aria-hidden="true"
        class="absolute inset-0 animate-breathe rounded-full bg-accent shadow-[0_6px_20px_2px_rgb(255_105_0/0.4)] motion-reduce:animate-none"
      />
    )
  }
  <svg class="relative" width={size} height={size} viewBox="0 0 260 260" fill="none" aria-hidden="true">
    <circle cx="130" cy="130" r="130" fill={`url(#${id})`}></circle>
    {
      spin &&
        TRAILS.map(([lag, opacity, width]) => (
          <path
            d={CURVE}
            stroke="#FFF085"
            stroke-width={width}
            stroke-linecap="round"
            opacity={opacity}
            class="origin-center animate-swirl [transform-box:view-box] motion-reduce:hidden"
            style={`animation-delay:${lag * 2.6}s`}
          />
        ))
    }
    <path
      d={CURVE}
      stroke="#FFF085"
      stroke-width="24"
      stroke-linecap="round"
      class:list={[spin && "origin-center animate-swirl [transform-box:view-box] motion-reduce:animate-none"]}></path>
    <defs>
      <linearGradient id={id} x1="48.5" y1="31.5" x2="222.5" y2="220.5" gradientUnits="userSpaceOnUse">
        <stop stop-color="#FF8E3E"></stop>
        <stop offset=".3236" stop-color="#F0B100"></stop>
        <stop offset="1" stop-color="#D8F999"></stop>
      </linearGradient>
    </defs>
  </svg>
</span>

---
import type { Lang } from "../config";
import { COPY } from "../content/copy";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = COPY[lang];

/** Six features on a two by three grid. */
const TINT = ["var(--color-primary)", "var(--color-accent)", "var(--color-lime)"];
---

<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <h2 data-reveal class="max-w-2xl text-[clamp(2rem,5vw,3.25rem)] leading-tight font-extrabold tracking-tight text-balance">
    {c.featuresLabel}
  </h2>
  <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      c.features.map((f, i) => (
        <li
          data-reveal
          data-spotlight
          class="card-spotlight group overflow-hidden rounded-3xl border border-rule bg-card p-6 transition-transform duration-300 hover:-translate-y-1"
          style={`--t:${TINT[(i + Math.floor(i / 3)) % 3]};--i:${i % 3}`}
        >
          <div
            aria-hidden="true"
            class="absolute -top-16 -right-16 -z-10 size-48 rounded-full bg-[color-mix(in_srgb,var(--t)_22%,transparent)] blur-2xl transition-transform duration-500 group-hover:scale-125"
          />
          <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-[color-mix(in_srgb,var(--t)_22%,var(--card))] text-primary-ink transition-transform duration-300 group-hover:-rotate-6">
            <Icon name={f.icon} />
          </span>
          <h3 class="mt-5 text-xl font-extrabold tracking-tight">{f.title}</h3>
          <p class="mt-2 text-muted">{f.body}</p>
        </li>
      ))
    }
  </ul>
</section>

---
import type { Lang } from "../config";
import Base from "../layouts/Base.astro";
import Bento from "./Bento.astro";
import SpiritParade from "./SpiritParade.astro";
import FinalCta from "./FinalCta.astro";
import Footer from "./Footer.astro";
import Hero from "./Hero.astro";
import HowSection from "./HowSection.astro";
import PhoneSection from "./PhoneSection.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base lang={lang}>
  <Hero lang={lang} />
  <main>
    <PhoneSection lang={lang} />
    <HowSection lang={lang} />
    <SpiritParade lang={lang} />
    <Bento lang={lang} />
    <FinalCta lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>

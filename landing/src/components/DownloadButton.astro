---
import { APK_URL } from "../config";
import Icon from "./Icon.astro";

interface Props {
  label: string;
  small?: boolean;
}
const { label, small = false } = Astro.props;
---

<a
  href={APK_URL}
  rel="noopener"
  class:list={[
    "inline-flex items-center gap-2.5 rounded-full bg-linear-135 from-[#5866e8] to-primary-ink font-extrabold text-white shadow-[0_12px_30px_-10px_rgb(70_82_214/0.7)] transition-transform hover:-translate-y-0.5",
    small ? "px-4 py-2 text-sm" : "px-6 py-3.5 text-[17px]",
  ]}
>
  {!small && <Icon name="download" size={20} />}
  {label}
</a>

---
import { APK_URL } from "../config";
import Icon from "./Icon.astro";

interface Props {
  label: string;
  small?: boolean;
}
const { label, small = false } = Astro.props;
---

<a
  href={APK_URL}
  rel="noopener"
  class:list={[
    "group relative inline-flex items-center gap-2.5 overflow-hidden rounded-full font-extrabold text-primary-fg shadow-[0_12px_30px_-10px_rgb(255_105_0/0.6)] transition-transform hover:-translate-y-0.5",
    small ? "bg-primary px-4 py-2 text-sm" : "border-moving px-6 py-3.5 text-[17px] motion-reduce:animate-none",
  ]}
>
  <span
    aria-hidden="true"
    class="absolute inset-y-0 -left-1/2 w-1/2 -skew-x-12 bg-linear-90 from-transparent via-white/45 to-transparent transition-transform duration-700 group-hover:translate-x-[300%]"
  ></span>
  {!small && <Icon name="download" size={20} />}
  {label}
</a>

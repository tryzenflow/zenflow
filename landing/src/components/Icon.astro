---
import type { IconName } from "../content/copy";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

/** Zenflow glyphs from mobile/components/brand/icons.tsx; globe, lock and download are Lucide. */
const PATHS: Record<IconName, string> = {
  calendar: '<rect x="3" y="4" width="18" height="17" rx="4"/><path d="M3 9h18"/><circle cx="12" cy="15" r="2.4" fill="currentColor" stroke="none"/>',
  sunrise: '<path d="M3 18h18M7 18a5 5 0 0 1 10 0M12 6v2.5M5.6 9.6l1.6 1.6M18.4 9.6l-1.6 1.6"/>',
  sliders: '<path d="M4 8h16M4 16h16"/><circle cx="9" cy="8" r="2.6" fill="var(--card)"/><circle cx="15" cy="16" r="2.6" fill="var(--card)"/>',
  dial: '<path d="M12 3.5a8.5 8.5 0 1 0 8.5 8.5M12 7.5V12l3 2"/>',
  "cloud-off": '<path d="M7.5 18.5h9.2a4 4 0 0 0 1-7.9 6 6 0 0 0-10.9-1.1A4.5 4.5 0 0 0 7.5 18.5zM4 4l16 16"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  download: '<path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/>',
  check: '<path d="M5 12.5l4.2 4.2L19 7"/>',
};

const { name, size = 22, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={PATHS[name]}
/>

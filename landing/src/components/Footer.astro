---
import { CONTACT_EMAIL, type Lang, legalUrl } from "../config";
import { COPY } from "../content/copy";
import Logo from "./Logo.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = COPY[lang];
---

<footer class="border-t border-rule">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p class="flex items-center gap-2">
      <Logo size={20} />
      © {new Date().getFullYear()} Zenflow. {c.rightsReserved}
    </p>
    <nav class="flex flex-wrap gap-x-5 gap-y-2">
      <a href={legalUrl("privacy", lang)} class="hover:text-fg">{c.privacyLink}</a>
      <a href={legalUrl("terms", lang)} class="hover:text-fg">{c.termsLink}</a>
      <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-fg">{c.contact}</a>
    </nav>
  </div>
</footer>

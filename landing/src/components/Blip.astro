---
/** Placeholder Blip until `packages/blips` (#259) ships the real parts. */
interface Props {
  body: string;
  belly: string;
  shape: 0 | 1 | 2;
  extra: "ears" | "sprout" | "horns" | "none";
}
const { body, belly, shape, extra } = Astro.props;

const BODIES = [
  "M60 18c26 0 44 22 44 52s-18 42-44 42-44-12-44-42 18-52 44-52z",
  "M60 22c30 0 48 18 48 48 0 26-20 40-48 40S12 96 12 70c0-30 18-48 48-48z",
  "M60 14c22 0 38 26 40 56 2 28-16 40-40 40S18 98 20 70c2-30 18-56 40-56z",
];
---

<svg viewBox="0 0 120 120" width="96" height="96" aria-hidden="true">
  {
    extra === "ears" && (
      <g fill={body}>
        <ellipse cx="34" cy="28" rx="10" ry="16" transform="rotate(-20 34 28)" />
        <ellipse cx="86" cy="28" rx="10" ry="16" transform="rotate(20 86 28)" />
      </g>
    )
  }
  {
    extra === "sprout" && (
      <g>
        <path d="M60 22v-10" stroke="#4FD1A5" stroke-width="4" stroke-linecap="round" />
        <ellipse cx="68" cy="10" rx="9" ry="5" fill="#4FD1A5" transform="rotate(-20 68 10)" />
      </g>
    )
  }
  {
    extra === "horns" && (
      <g fill="#FFD66B">
        <path d="M38 30l-6-16 14 10z" />
        <path d="M82 30l6-16-14 10z" />
      </g>
    )
  }
  <path d={BODIES[shape]} fill={body}></path>
  <ellipse cx="60" cy="84" rx="26" ry="20" fill={belly} opacity=".55"></ellipse>
  <g fill="#1d1e2c">
    <ellipse cx="46" cy="60" rx="5" ry="6.5"></ellipse>
    <ellipse cx="74" cy="60" rx="5" ry="6.5"></ellipse>
  </g>
  <g fill="#fff">
    <circle cx="47.5" cy="57.5" r="1.8"></circle>
    <circle cx="75.5" cy="57.5" r="1.8"></circle>
  </g>
  <g fill="#FF6F91" opacity=".45">
    <ellipse cx="38" cy="72" rx="6" ry="3.5"></ellipse>
    <ellipse cx="82" cy="72" rx="6" ry="3.5"></ellipse>
  </g>
  <path d="M54 72q6 6 12 0" stroke="#1d1e2c" stroke-width="3" fill="none" stroke-linecap="round"></path>
</svg>

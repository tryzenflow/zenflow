---
import type { Lang } from "../config";
import { RARITY, type Spirit } from "../content/spirits";

interface Props {
  spirit: Spirit;
  lang: Lang;
}
const { spirit, lang } = Astro.props;
const { b, s, h, a, e, glow } = spirit.palette;
const glowing = spirit.rarity >= 3;
---

<figure
  class="flex w-48 shrink-0 flex-col items-center text-center"
  style={`--sp-b:${b};--sp-s:${s};--sp-h:${h};--sp-a:${a};--sp-e:${e};--sp-glow:${glow}`}
>
  <div class="relative isolate grid aspect-square w-full place-items-center">
    {
      glowing && (
        <div
          class="absolute inset-[2%] -z-20 animate-[spin_9s_linear_infinite] rounded-full opacity-80 blur-xl motion-reduce:animate-none"
          style="background:conic-gradient(from 0deg,transparent,color-mix(in srgb,var(--sp-glow) 45%,transparent),transparent 40%,color-mix(in srgb,var(--sp-glow) 35%,transparent),transparent 80%)"
        />
      )
    }
    <div
      class="absolute inset-[8%] -z-10 rounded-full"
      style="background:radial-gradient(circle at 50% 58%,color-mix(in srgb,var(--sp-glow) 24%,transparent),color-mix(in srgb,var(--sp-glow) 8%,transparent) 72%)"
    >
    </div>
    <svg class="sp-breathe w-[96%] overflow-visible" viewBox="0 0 200 200" aria-hidden="true">
      <use href={`#sp-${spirit.kind}`}></use>
    </svg>
  </div>
  <figcaption class="mt-1">
    <span class="block text-[17px] font-extrabold tracking-tight">{spirit.name[lang]}</span>
    <span class="mt-1 flex items-center justify-center gap-2 text-xs font-semibold text-muted">
      <span style="color:color-mix(in srgb,var(--sp-glow) 75%,var(--fg))">{spirit.element[lang]}</span>
      <span class="flex gap-[3px]" aria-label={RARITY[lang][spirit.rarity]}>
        {
          [1, 2, 3, 4].map((i) => (
            <i
              class="size-1.5 rotate-45 rounded-[1px]"
              style={`background:${i <= spirit.rarity ? "var(--sp-glow)" : "var(--rule)"}`}
            />
          ))
        }
      </span>
      <span>{RARITY[lang][spirit.rarity]}</span>
    </span>
  </figcaption>
</figure>

<style is:global>
  symbol .b { fill: var(--sp-b); }
  symbol .s { fill: var(--sp-s); }
  symbol .h { fill: var(--sp-h); }
  symbol .a { fill: var(--sp-a); }
  symbol .e { fill: var(--sp-e); }
  symbol .t { fill: var(--sp-t, #fffaf2); }
  symbol .as, symbol .ss, symbol .bs { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  symbol .as { stroke: var(--sp-a); }
  symbol .ss { stroke: var(--sp-s); }
  symbol .bs { stroke: var(--sp-b); }
  symbol .fm { fill: none; stroke: var(--sp-a); stroke-width: 24; stroke-linecap: round; opacity: 0.9; }
  symbol .sway { transform-box: view-box; animation: sp-sway 3.6s ease-in-out infinite; }
  symbol .flap { transform-box: view-box; animation: sp-flap 2.8s ease-in-out infinite; }
  symbol .flick { animation: sp-flick 3.4s ease-in-out infinite; }
  .sp-breathe { transform-origin: 50% 88%; animation: sp-breathe 3.4s ease-in-out infinite; }
  @keyframes sp-breathe { 50% { transform: translateY(-3px) scale(1.015); } }
  @keyframes sp-sway { 50% { transform: rotate(5deg); } }
  @keyframes sp-flap { 50% { transform: rotate(-9deg); } }
  @keyframes sp-flick { 0%, 48%, 53%, 100% { opacity: 1; } 50% { opacity: 0.2; } }
  @media (prefers-reduced-motion: reduce) {
    .sp-breathe, symbol .sway, symbol .flap, symbol .flick { animation: none; }
  }
</style>

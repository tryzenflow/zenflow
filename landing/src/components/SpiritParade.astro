---
import type { Lang } from "../config";
import { COPY } from "../content/copy";
import { SPIRITS } from "../content/spirits";
import Spirit from "./Spirit.astro";
import SpiritSprites from "./SpiritSprites.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = COPY[lang];
---

<section class="overflow-hidden py-24">
  <SpiritSprites />
  <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
    <p class="inline-flex rounded-full bg-accent px-3 py-1 text-sm font-semibold text-primary-fg">{c.spiritsLabel}</p>
    <h2 data-reveal class="mt-3 text-[clamp(2rem,5vw,3.25rem)] leading-tight font-extrabold tracking-tight">{c.spiritsTitle}</h2>
    <p class="mt-2 text-lg text-muted">{c.spiritsBody}</p>
  </div>
  <div
    class="group mt-10 flex [mask-image:linear-gradient(90deg,transparent,#000_10%,#000_90%,transparent)] [--marquee-duration:60s] motion-reduce:overflow-x-auto"
  >
    {
      [0, 1].map((copyIndex) => (
        <ul
          class:list={[
            "flex shrink-0 animate-marquee gap-6 pr-6 group-hover:[animation-play-state:paused] motion-reduce:animate-none",
            copyIndex === 1 && "motion-reduce:hidden",
          ]}
          aria-hidden={copyIndex === 1 ? "true" : undefined}
        >
          {SPIRITS.map((spirit) => (
            <li>
              <Spirit spirit={spirit} lang={lang} />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

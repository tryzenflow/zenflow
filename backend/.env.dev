DATABASE_URL="postgres://admin:admin@localhost:5432/zenflow?sslmode=disable&schema=public"

CACHE_URL="redis://localhost:6379"
# Separate Redis instance dedicated to LimitKit's rate-limit counters (see
# src/common/rate-limit/) — kept off the session/OTP Redis above.
RATE_LIMIT_CACHE_URL="redis://localhost:6380"
# Comma-separated web origins (see main.ts) — frontend's Vite dev server and
# mobile's Expo web dev server. Native iOS/Android requests aren't subject to
# CORS at all, so they don't need an entry here.
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"
MAIL_TRANSPORT="smtp://localhost:1025"
MAIL_FROM="noreply@zenflow.io"
SESSION_SECRET='s3cr3t'
# Idle session lifetime in ms (rolling: active use keeps extending it). 7 days.
SESSION_TTL_MS=604800000
# Session cookie flags. Dev is same-site (localhost, just different ports) over
# HTTP, so secure off + lax — Lax cookies are still sent cross-port on the same
# site, just not cross-site.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
UPLOADED_FILES_DEST=uploads/
# LimitKit rate limits on the OTP-sending auth endpoints (see
# src/common/rate-limit/). Sliding windows: *_WINDOW_SEC in seconds, *_LIMIT
# is the max requests allowed per window. All optional — these are the
# built-in Joi defaults, listed explicitly here as a tuning example.
OTP_REQUEST_IP_WINDOW_SEC=60
OTP_REQUEST_IP_LIMIT=5
OTP_REQUEST_EMAIL_WINDOW_SEC=900
OTP_REQUEST_EMAIL_LIMIT=3
OTP_VERIFY_IP_WINDOW_SEC=60
OTP_VERIFY_IP_LIMIT=20
OTP_VERIFY_EMAIL_WINDOW_SEC=600
OTP_VERIFY_EMAIL_LIMIT=10

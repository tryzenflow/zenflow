# Example .env files
# Copy into `.env.dev` / `.env.test` / `.env.staging` / `.env.prod` and fill in secrets
# Deployed envs get these injected from the secret store (docs/ops/secrets.md); any
# variable can also be supplied as FOO_FILE=/run/secrets/foo (read at boot).

# Postgres container (read by compose; must match DATABASE_URL)
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=zenflow

DATABASE_URL="postgres://admin:admin@zenflow-db-prod:5432/zenflow-prod?sslmode=disable&schema=public"
CACHE_URL="redis://zenflow-cache-prod:6379"

# Separate Redis instance dedicated to LimitKit's rate-limit counters (see
# src/common/rate-limit/) — kept off the session/OTP Redis above.
RATE_LIMIT_CACHE_URL="redis://zenflow-cache-ratelimit-prod:6379"

# BullMQ job queues (src/queue/, ADR-0007): dedicated Redis with noeviction + AOF.
# Required in production. Dev default: redis://localhost:6381 (compose `redis-queue`).
# Unset in .env.test: jobs are then recorded in memory and never consumed.
QUEUE_REDIS_URL="redis://zenflow-cache-queue-prod:6379"
# Attempts per job (first run included) and exponential backoff base, then <queue>.dlq.
QUEUE_JOB_ATTEMPTS=5
QUEUE_BACKOFF_MS=5000
# Producer calls reject after this when the queue Redis is down; workers get SHUTDOWN_TIMEOUT to drain.
# QUEUE_ENQUEUE_TIMEOUT_MS=2000
# QUEUE_SHUTDOWN_TIMEOUT_MS=25000
# Optional per-queue tuning (queues: PORTAL_FETCH, LMS_FETCH, NOTIFY): concurrency per
# replica; RATE_MAX jobs per RATE_DURATION_MS across replicas. Defaults live in src/queue/queues.ts.
# QUEUE_NOTIFY_CONCURRENCY=10
# QUEUE_NOTIFY_RATE_MAX=50
# QUEUE_NOTIFY_RATE_DURATION_MS=1000
# Process role: api | watcher | worker-portal | worker-lms | worker-notify | worker | all (default).
# Compose sets it per service; leave unset for local dev (all).
# ROLE=all

# SSE fan-out across processes (ADR-0018): dedicated Redis, no persistence. Unset = in-process
# only (single-process dev, tests). Dev: redis://localhost:6382 (compose `redis-pubsub`).
REDIS_PUBSUB_URL="redis://zenflow-cache-pubsub-prod:6379"
CORS_ORIGIN="https://zenflow.alphatrann.com"
MAIL_TRANSPORT="smtp://<username>:<password>@<host>:<port>"
SESSION_SECRET='<random 64 char>'
GRPC_SCHEDULER_URL='zenflow-scheduler-prod:50051'

# master keys: gen via openssl rand -hex 32
MASTER_LMS_ENCRYPTION_KEY_V1=
MASTER_PORTAL_ENCRYPTION_KEY_V1=

# Idle session lifetime in ms (rolling: active use keeps extending it). 7 days.
SESSION_TTL_MS=604800000
# S3-compatible object storage for uploaded files. The bucket must exist.
# Compose service name (containers). For `pnpm start:dev` on the host use http://localhost:9000.
S3_ENDPOINT=http://storage:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=zenflow
S3_SECRET_ACCESS_KEY=zenflow-secret
S3_BUCKET=zenflow-files
# HMAC key for signed /files/:id?sig= URLs (>=32 chars). Rotating it breaks all stored links.
FILE_URL_SECRET='<random 64 char>'

# LimitKit rate limits on the OTP-sending auth endpoints (see
# src/common/rate-limit/). Sliding windows: *_WINDOW_SEC in seconds, *_LIMIT
# is the max requests allowed per window.
OTP_REQUEST_IP_WINDOW_SEC=60
OTP_REQUEST_IP_LIMIT=5
OTP_REQUEST_IP_HOURLY_WINDOW_SEC=3600
OTP_REQUEST_IP_HOURLY_LIMIT=20
OTP_REQUEST_EMAIL_WINDOW_SEC=900
OTP_REQUEST_EMAIL_LIMIT=3
OTP_VERIFY_IP_WINDOW_SEC=60
OTP_VERIFY_IP_LIMIT=20
OTP_VERIFY_EMAIL_WINDOW_SEC=600
OTP_VERIFY_EMAIL_LIMIT=10
SYNC_MANUAL_COOLDOWN_SEC=900
SYNC_MANUAL_WAIT_MS=25000
RATE_LIMIT_STORE_TIMEOUT_MS=250

# login at https://online.dlu.edu.vn
# inspect Network tab
# search for /api/authenticate/authpsc
# get the Apikey in the headers and put it here
PORTAL_API_KEY="<base64 key>"

# DKHP (course registration) API — drives enrolment discovery via
# POST /api/student/getAllRegistHistory. Same login and credentials as the
# portal, with clientid "dtl" and its own key. Get both the same way as above,
# from the DKHP site's authpsc request; never commit the real values.
# The URL is the API host (https://dkhp-api.dlu.edu.vn), not the website
# (dkhp.dlu.edu.vn), which answers every path with HTML.
DKHP_API_URL="<DKHP API base URL>"
DKHP_API_KEY="<DKHP apikey header value>"

# --- DLU ingestion (src/lms/, src/portal/, src/ingestion/) -------------------
# Upstream DLU endpoints. LMS_URL / PORTAL_API_URL / PORTAL_API_TIMEOUT_MS are
# read with getOrThrow at construction — they have Joi defaults matching the
# values below, so they're safe to leave commented out.
LMS_URL="https://lms.dlu.edu.vn"
PORTAL_API_URL="https://portal-api.dlu.edu.vn"
# Per-request timeouts in ms. The LMS budget is looser: its login is a
# multi-step form flow, not one JSON call.
LMS_TIMEOUT_MS=15000
PORTAL_API_TIMEOUT_MS=10000
# IANA timezone the DLU timetable/exam wall-clock strings are expressed in.
# A property of the upstream data, not of the user.
DLU_TZ="Asia/Ho_Chi_Minh"
# Kill switch for DLU ingestion. false = the ingestion ticker stays registered but
# return immediately.
INGESTION_ENABLED=true
# Fixed pause between a watcher's outbound DLU requests, in ms.
INGESTION_REQUEST_DELAY_MS=750

# --- DLU ingestion: rolling scheduler + occurrence cache (issue #56) ---------
# All optional; the values below are the defaults. One minute ticker claims the
# most-overdue few students per sync kind, so these periods set the cadence.
# DKHP discovery runs once per term (~a semester) and again on a term change.
# INGESTION_PORTAL_DISCOVERY_PERIOD_MS=10368000000
# INGESTION_LMS_DISCOVERY_PERIOD_MS=86400000
# INGESTION_TIMETABLE_PERIOD_MS=86400000
# INGESTION_EXAM_PERIOD_MS=86400000
# INGESTION_LMS_CALENDAR_PERIOD_MS=3600000
# Max students one tick claims per kind — the rail that keeps load spread.
# INGESTION_TICK_MAX_BATCH=20
# Stop starting further kinds once a tick has run this long.
# INGESTION_TICK_BUDGET_MS=48000
# Stop claiming for a fetch queue once waiting+delayed jobs reach this.
# INGESTION_QUEUE_MAX_BACKLOG=500
# Outbound circuit breakers (one per external API, e.g. dlu-lms, dlu-portal):
# open after N consecutive timeouts/connect errors/5xx/429, stay open OPEN_MS,
# then probe once; a failed probe doubles the open time up to MAX_OPEN_MS.
# INGESTION_BREAKER_FAILURES=5
# INGESTION_BREAKER_OPEN_MS=60000
# INGESTION_BREAKER_MAX_OPEN_MS=600000
# Rollout gate for the timetable / Moodle cache: lets a walk be skipped and a
# classmate's fetch update your calendar. Exams are always a plain fetch.
# Discovery is always on; the timetable walk waits for it.
# INGESTION_OCCURRENCE_CACHE_ENABLED=false
# Past this age one student's live walk refreshes a cached section/course for all.
# INGESTION_CACHE_TTL_MS=604800000
# A Moodle confirmed set older than this is ignored and the student is walked live.
# INGESTION_DISCOVERY_MAX_AGE_MS=172800000
# Force a live walk every N consecutive cache-served passes (the cache audit).
# INGESTION_FULL_WALK_EVERY=7
# Max classmates one cache-discovered change is fanned out to in one pass.
# INGESTION_FANOUT_MAX_STUDENTS=200
# Moodle current-term filter: shadow (log only) | enforce | off. Keep "shadow"
# until it has been validated against a real account.
# INGESTION_LMS_TERM_FILTER=shadow

# Base URL of the stateless Python bandit service (services/bandit/). Optional —
# omit to disable LinUCB scheduling (heuristic-only). REQUIRED when NODE_ENV=production.
BANDIT_SERVICE_URL=http://localhost:8100

# Optional shared bearer secret for /v1/place (Python side verifies it).
# BANDIT_SERVICE_TOKEN=
# Total /v1/place timeout in ms (default 2500).
# PLACE_TIMEOUT_MS=2500
# Test env only: emit a Server-Timing header on responses (dayload/http/scan/...).
# BENCH_TIMING=1

# --- Native mobile push (src/devices/) --------------------------------------
# Each provider self-disables when its vars are unset — omit both blocks and
# POST /devices still records tokens, but nothing is ever delivered.
# Android (FCM): base64 of the Firebase service-account JSON.
#   base64 -w0 service-account.json
FCM_SERVICE_ACCOUNT=
# iOS (APNs, token auth): base64 of the AuthKey_XXXXXXXXXX.p8 contents, its key
# id, the Apple team id, and the app bundle id (= the APNs topic).
#   base64 -w0 AuthKey_XXXXXXXXXX.p8
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# true -> api.push.apple.com, false -> the sandbox gateway.
APNS_PRODUCTION=false

# --- Observability (src/observability/, src/tracing.ts) ---------------------
# tracing.ts is preloaded via `--require` in `start:prod` and reads the OTEL_*
# vars directly. Traces + metrics go OTLP/HTTP to this collector base (the SDK
# appends /v1/traces and /v1/metrics). In the prod compose stack this is
# http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=zenflow-api
# "true" makes the whole SDK a no-op (dev / CI don't preload tracing.ts anyway).
OTEL_SDK_DISABLED=false
# Head sampling: parentbased_traceidratio + a 0..1 ratio. Start at 1 and lower.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
# pino level. Defaults to info in production, debug otherwise.
LOG_LEVEL=info
# A request at/above this many ms is always logged, sampling aside.
HTTP_SLOW_REQUEST_MS=1000
# Grafana (compose.prod.yml) — the dashboards/Explore UI on 127.0.0.1:3000.
# Anonymous access is off in prod; set a real admin password.
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# Runtime kill switch flags (ADR-0008, docs/ops/kill-switch.md): dedicated
# noeviction + AOF Redis. Required in production; unset = fail-safe defaults.
# Dev default: redis://localhost:6383 (compose `redis-killswitch`).
REDIS_KILLSWITCH_URL="redis://zenflow-cache-killswitch-prod:6379"

<html lang="{{language}}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{pageTitle}}</title>

    <style>
      /* Geist-like system fallback stack */
      @font-face {
        font-family: "Geist";
        src: local("Geist"), local("Geist Variable");
      }

      body {
        background-color: #f6f6f6;
        margin: 0;
        padding: 40px 0;
        font-family:
          "Geist",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        color: #111;
      }

      .email-wrapper {
        max-width: 600px;
        margin: auto;
        background: #ffffff;
        border-radius: 12px;
        padding: 32px;
        border: 1px solid #e5e5e5;
      }

      .logo {
        text-align: center;
        margin-bottom: 28px;
        font-weight: 600;
        font-size: 26px;
        color: #973c00;
      }

      .logo-avatar {
        display: block;
        margin: 0 auto 12px;
        width: 64px;
        height: 64px;
        border-radius: 50%;
      }

      .content {
        font-size: 15px;
        line-height: 1.7;
        color: #333;
      }

      .otp-box {
        margin: 32px auto;
        padding: 24px;
        border-radius: 10px;
        border: 1px solid #e5e5e5;
        font-size: 32px;
        font-weight: 600;
        letter-spacing: 6px;
        text-align: center;
        background: #fafafa;
      }

      .footer {
        margin-top: 32px;
        text-align: center;
        font-size: 12px;
        color: #888;
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <div class="logo">
        <img
          src="cid:logo"
          alt="Zenflow"
          width="64"
          height="64"
          class="logo-avatar"
        />
        Zenflow
      </div>

      <div class="content">
        <p>{{greeting}}</p>

        <p>
          {{welcome}}
        </p>

        <p>{{instructions}}</p>

        <div class="otp-box">{{otp}}</div>

        <p>
          {{expires}}
        </p>

        <p>
          {{ignore}}
        </p>

        <p>{{thanks}}<br />{{team}}</p>
      </div>

      <div class="footer">© 2025 Zenflow. {{rights}}</div>
    </div>
  </body>
</html>
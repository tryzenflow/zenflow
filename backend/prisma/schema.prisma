generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  engineType    = "binary"
  binaryTargets = "native"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(30)
  email     String   @unique @db.VarChar(30)
  timezone  String   @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks      Task[]
  categories Category[]
  prefs      UserPreference[]
  files      File[]
}

model Task {
  id       String    @id @default(uuid())
  title    String
  note     String?
  duration Int
  deadline DateTime?
  energy   Int       @default(1) // 1–3
  rrule    String?

  userId     String
  categoryId String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  scheduledBlocks ScheduledBlock[]

  fixedWindow TaskWindow?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model TaskWindow {
  id    String @id @default(uuid())
  start Int    @db.SmallInt
  end   Int    @db.SmallInt

  fixedTaskId String? @unique // FK for fixed window
  fixedTask   Task?   @relation(fields: [fixedTaskId], references: [id], onDelete: Cascade)
}

model ScheduledBlock {
  id         String   @id
  start      DateTime
  end        DateTime
  splitIndex Int      @db.SmallInt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([start, end])
}

model UserPreference {
  id                 String @id @default(uuid())
  minGapBetweenTasks Int    @default(0)
  day                Int    @default(0) @db.SmallInt // 0=Sun, 1=Mon, ..., 6=Sat

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  energyBlocks EnergyBlock[]

  @@unique([userId, day])
  @@index([userId, day])
}

model EnergyBlock {
  id         String @id @default(uuid())
  energy     Float // 1–3
  confidence Float  @default(0.2) // 0-1
  start      Int    @db.SmallInt
  end        Int    @db.SmallInt

  userPref         UserPreference @relation(fields: [userPreferenceId], references: [id])
  userPreferenceId String
}

model Category {
  id     String @id @default(uuid())
  name   String
  userId String
  order  Float  @default(0)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model File {
  id           String   @id @default(uuid())
  originalName String
  filename     String
  path         String
  mimetype     String
  size         Int
  userId       String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

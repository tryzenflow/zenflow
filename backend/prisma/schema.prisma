generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  engineType    = "binary"
  binaryTargets = "native"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(30)
  email     String   @unique @db.VarChar(30)
  createdAt DateTime @default(now())
  timezone  String   @db.VarChar(50)

  // Relations
  tasks      Task[]
  categories Category[]
  prefs      UserPreference[]
  files      File[]
}

model Task {
  id       String    @id @default(uuid())
  title    String
  note     String?
  duration Int
  priority Int       @default(3) // 1–3 (lower = more important)
  deadline DateTime?
  energy   Int       @default(1) // 1–3
  rrule    String?

  userId     String
  categoryId String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  scheduledBlocks ScheduledBlock[]

  fixedWindow      TaskWindow?  @relation("TaskFixedWindow")
  preferredWindows TaskWindow[] @relation("TaskPreferredWindows")

  createdAt DateTime @default(now())

  @@index([userId])
}

model TaskWindow {
  id    String @id @default(uuid())
  start Int    @db.SmallInt
  end   Int    @db.SmallInt

  taskId String? @unique // FK for fixed window
  task   Task?   @relation("TaskFixedWindow", fields: [taskId], references: [id], onDelete: Cascade)

  preferredTaskId String? // FK for preferred window
  preferredOfTask Task?   @relation("TaskPreferredWindows", fields: [preferredTaskId], references: [id], onDelete: Cascade)
}

model ScheduledBlock {
  id         String   @id @default(uuid())
  start      DateTime
  end        DateTime
  splitIndex Int      @db.SmallInt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([start, end])
}

model UserPreference {
  id                 String @id @default(uuid())
  minGapBetweenTasks Int    @default(0)
  day                Int    @default(0) @db.SmallInt // 0=Sun, 1=Mon, ..., 6=Sat

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  energyBlocks EnergyBlock[]

  @@unique([userId, day])
  @@index([userId])
}

model EnergyBlock {
  id     String @id @default(uuid())
  energy Int    @db.SmallInt // 1–3
  start  Int    @db.SmallInt
  end    Int    @db.SmallInt

  userPref         UserPreference @relation(fields: [userPreferenceId], references: [id])
  userPreferenceId String
}

model Category {
  id     String @id @default(uuid())
  name   String
  userId String
  order  Float  @default(0)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name])
  @@index([userId])
}

model File {
  id           String @id @default(uuid())
  originalName String
  filename     String
  path         String
  mimetype     String
  size         Int
  userId       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

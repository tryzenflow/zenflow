generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  engineType    = "binary"
  binaryTargets = "native"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  name     String @db.VarChar(60)
  email    String @unique @db.VarChar(255)
  timezone String @default("UTC") @db.VarChar(50)

  // Working window (see docs/objects.md). Minutes from midnight + ISO weekdays.
  workStart Int   @default(540) // 09:00
  workEnd   Int   @default(1020) // 17:00
  workDays  Int[] @default([1, 2, 3, 4, 5]) // 1=Mon … 7=Sun

  // Flat 336-int penalty matrix (7 days × 48 half-hour slots). Written on MOVE
  // in Phase 1 (telemetry); not yet read by the scheduler. Seeded lazily.
  penaltyMatrix Int[] @default([])

  roleArchetypeId    String? // Phase-4 cold-start cluster id
  onboardingComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks      Task[]
  files      File[]
  taskEvents TaskEvent[]
}

enum TaskStatus {
  PENDING
  DONE
}

model Task {
  id              String     @id @default(uuid())
  title           String
  note            String? // rich-text (TipTap) — carried over from v1
  durationMinutes Int // positive multiple of 15
  deadline        DateTime?
  tags            String[]   @default([]) // free-form labels (text[])
  fixed           Boolean    @default(false)
  startTime       Int        @default(0) // minutes from midnight; used when fixed
  status          TaskStatus @default(PENDING)
  conflict        Boolean    @default(false) // unplaced (no slot before deadline)
  rrule           String     @default("") // RFC 5545; "" when non-recurring
  seriesId        String? // shared by every materialized occurrence of a recurring series; null when non-recurring

  scheduledStartTime DateTime? // assigned by the EDF engine

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  events TaskEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, deadline])
  @@index([userId, status])
  @@index([userId, scheduledStartTime])
  @@index([userId, seriesId])
}

enum TaskEventType {
  CREATE
  MOVE
  RESIZE
  COMPLETE
}

model TaskEvent {
  id          BigInt        @id @default(autoincrement())
  eventType   TaskEventType
  oldSnapshot Json? // { scheduledStartTime, durationMinutes }; null on CREATE
  newSnapshot Json
  rewardScore Float         @default(1.0) // Phase-3 signal
  occurredAt  DateTime      @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String // denormalized for partition/range queries
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([taskId])
}

model File {
  id           String   @id @default(uuid())
  originalName String
  filename     String
  path         String
  mimetype     String
  size         Int
  userId       String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

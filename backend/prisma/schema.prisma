generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  engineType    = "binary"
  binaryTargets = "native"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  VI_VN @map("vi-VN")
  EN_US @map("en-US")
}

model User {
  id       String   @id @default(uuid())
  name     String   @db.VarChar(60)
  email    String   @unique @db.VarChar(255)
  timezone String   @default("Asia/Saigon") @db.VarChar(50)
  lang     Language @default(VI_VN)

  preferenceMatrix Float[] @default([])
  preferenceMatrixDecayedAt DateTime?

  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  tasks      Task[]
  files      File[]
  taskEvents TaskEvent[]
  tags       Tag[]

  encryptionKeys UserEncryptionKey[]
  devices        UserDevice[]
  taskSeries     TaskSeries[]
  integrations   Integration[]
  notifications  Notification[]
  slotProposals  SlotProposal[]
}

// Per-user data-encryption key, itself protected by a server-held master key
// kept outside the DB.
model UserEncryptionKey {
  id        String   @id @default(uuid())
  version   Int
  key       String
  iv        String
  algorithm String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DevicePlatform {
  IOS
  ANDROID
}

// Expo push registration; one row per device so a user can have multiple.
model UserDevice {
  id         String         @id @default(uuid())
  platform   DevicePlatform
  pushToken  String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lastSeenAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Links N session-instance Tasks of one "study sessions" goal. Deleting a
// TaskSeries cascades to all its Task rows — that's how "delete whole series"
// is implemented at the app layer.
model TaskSeries {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([userId])
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Implicit many-to-many with Task.
  tasks Task[]

  @@unique([userId, name])
  @@index([userId])
}

enum TaskStatus {
  PENDING
  DONE // completed
  ABANDONED // deadline passed while still PENDING (set by the overdue sweep)
}

enum TaskType {
  MANUAL
  ASSIGNMENT
  EXAM
  LECTURE
}

enum TaskSource {
  USER
  LMS
  PORTAL
}

model Task {
  id                 String     @id @default(uuid())
  title              String
  note               String?
  durationMinutes    Int // positive multiple of 15
  deadline           DateTime?
  startTime          Int        @default(0) // minutes from midnight of the last manual placement (informational only)
  status             TaskStatus @default(PENDING)
  type               TaskType   @default(MANUAL)
  source             TaskSource @default(USER)

  conflict           Boolean    @default(false)
  manuallyMoved      Boolean    @default(false)

  // limit the mobility of tasks when scheduling in a series so they don't fly around when optimizing
  anchorStartTime    DateTime?
  anchorEndTime      DateTime?
  scheduledStartTime DateTime?
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-user labels (implicit many-to-many).
  tags Tag[]

  events TaskEvent[]

  // Links N session-instance Task rows of one "study sessions" goal.
  // Deleting the TaskSeries cascades to every session it owns.
  seriesId     String?
  series       TaskSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  // Denormalized convenience fields for cheap per-row rendering alongside seriesId.
  sessionIndex Int?
  sessionTotal Int?

  reminders     TaskReminder[]
  notifications Notification[]
  slotProposals SlotProposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, deadline])
  @@index([userId, status])
  @@index([userId, scheduledStartTime])
  @@index([userId, seriesId, createdAt(sort: Asc)])
}

model TaskReminder {
  id                  String
  remindBeforeMinutes Int @default(15)

  taskId  String
  task    Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([remindBeforeMinutes, taskId])
}

enum TaskEventType {
  CREATE
  MOVE // user dragged to another slot/day
  RESIZE
  KEEP // user left an EDF suggestion in place (completed in its suggested slot) — positive signal
  COMPLETE // outcome: completed in its slot
  ABANDON // outcome: deadline expired unresolved (emitted by the overdue sweep)
  RESCHEDULED // task auto-repositioned as collateral in someone else's cascadeReschedule (not a user drag)
}

model TaskEvent {
  id          BigInt        @id @default(autoincrement())
  eventType   TaskEventType
  oldSnapshot Json? // { scheduledStartTime, durationMinutes }; null on CREATE
  newSnapshot Json
  rewardScore Float         @default(1.0) // Phase-3 signal
  occurredAt  DateTime      @default(now())

  batchId     String?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String // denormalized for partition/range queries
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([taskId])
  // Serves `undoBatch`: every TaskEvent written by one narrowResolve cascade.
  @@index([userId, batchId])
}

model File {
  id           String   @id @default(uuid())
  originalName String
  filename     String
  path         String
  mimetype     String
  size         Int
  userId       String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SlotProposalEvent {
  CREATE
  RESCHEDULE
}

enum SchedulingModel {
  HEURISTIC
  LINUCB
}

model SlotProposal {
  id                String            @id @default(uuid())
  event             SlotProposalEvent
  pickedModel       SchedulingModel
  heuristicProposal Json
  linucbProposal    Json
  batchId           String?
  timestamp         DateTime          @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

}

enum IntegrationProvider {
  LMS
  PORTAL
}

// Encrypted LMS/portal credentials, one row per (userId, provider).
model Integration {
  id                   String              @id @default(uuid())
  provider             IntegrationProvider
  encryptedCredentials String
  encryptionVersion    Int
  lastVerifiedAt       DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  crawlJobs     CrawlJob[]
  portalApiJobs PortalAPIJob[]

  @@unique([userId, provider])
  @@index([provider, userId])
  @@index([encryptionVersion(sort: Desc)])
}

enum NotificationTopic {
  ASSIGNMENT
  EXAM
  TIMETABLE
  REMINDER
  OVERDUE
}


model Notification {
  id            String            @id @default(uuid())
  sentAt        DateTime          @default(now())
  readAt        DateTime?
  actionTakenAt DateTime?
  topic         NotificationTopic
  title         String
  content       String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, sentAt(sort: Desc)])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Per-run job tracking for the LMS watcher.
model CrawlJob {
  id        String    @id @default(uuid())
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  items CrawlJobItem[]
}

model CrawlJobItem {
  id        String    @id @default(uuid())
  url       String
  status    JobStatus @default(PENDING)
  attempt   Int       @default(0)
  createdAt DateTime  @default(now())

  crawlJobId String
  crawlJob   CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)

  @@index([crawlJobId])
}

// Global (cross-user) dedupe table so two students' crawls of the same
// course activity don't double-detect.
model CrawledUrl {
  id        String   @id @default(uuid())
  url       String   @unique
  createdAt DateTime @default(now())
}

// Same job-tracking shape as CrawlJob/CrawlJobItem, for the portal API poller.
model PortalAPIJob {
  id        String    @id @default(uuid())
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  items PortalAPIJobItem[]
}

model PortalAPIJobItem {
  id           String    @id @default(uuid())
  url          String
  status       JobStatus @default(PENDING)
  attempt      Int       @default(0)
  statusCode   Int?
  responseBody String?
  createdAt    DateTime  @default(now())

  portalApiJobId String
  portalApiJob   PortalAPIJob @relation(fields: [portalApiJobId], references: [id], onDelete: Cascade)

  @@index([portalApiJobId])
}

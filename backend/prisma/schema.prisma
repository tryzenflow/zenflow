generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  engineType    = "binary"
  binaryTargets = "native"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  name     String @db.VarChar(60)
  email    String @unique @db.VarChar(255)
  timezone String @default("UTC") @db.VarChar(50)

  // Working window (see docs/objects.md). Minutes from midnight + ISO weekdays.
  workStart Int   @default(540) // 09:00
  workEnd   Int   @default(1020) // 17:00
  workDays  Int[] @default([1, 2, 3, 4, 5]) // 1=Mon … 7=Sun

  // Flat 168-float SIGNED preference matrix (7 days × 24 one-hour buckets).
  // Written as Phase-2 telemetry: keeps/moves-toward increment a cell (+1),
  // moves-away decrement it (-1); an empty cell is 0 (neutral). Seeded lazily.
  // Float (not Int) so the daily exponential decay (cell *= 2^(−Δdays/21))
  // accumulates sub-integer precision without truncation — integer storage
  // caused the pg driver to truncate 0.9677 → 0 on the first nightly decay,
  // zeroing all cells that were only incremented once.
  preferenceMatrix Float[] @default([])

  // When the daily decay cron last applied exponential time-decay to
  // `preferenceMatrix` (see MatrixDecayService). Null until the first decay
  // pass; the cron treats null as "no elapsed days" and only stamps the time.
  preferenceMatrixDecayedAt DateTime?

  onboardingComplete Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks      Task[]
  files      File[]
  taskEvents TaskEvent[]
  tags       Tag[]
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Implicit many-to-many with Task.
  tasks Task[]

  @@unique([userId, name])
  @@index([userId])
}

enum TaskStatus {
  PENDING
  DONE // completed
  ABANDONED // deadline passed while still PENDING (set by the overdue sweep)
}

model Task {
  id              String     @id @default(uuid())
  title           String
  note            String?
  durationMinutes Int // positive multiple of 15
  deadline        DateTime?
  startTime       Int        @default(0) // minutes from midnight of the last manual placement (informational only)
  status          TaskStatus @default(PENDING)
  // True when this task overlaps another task's interval, OR has no valid
  // placement at all (scheduledStartTime null). An overlap is now a normal,
  // ACCEPTED state — not something a cost model tries to prevent: a direct
  // drag/resize (TasksService.displace/resize) writes the user's requested
  // interval unconditionally and simply flags both tasks conflicting rather
  // than auto-relocating either one. Cleared by a follow-up drag/resize that
  // resolves the overlap, or by Optimize (optimize.ts).
  conflict        Boolean    @default(false)
  // True when the user directly dragged/resized this task. Informational
  // only everywhere automatic (badge/telemetry) — no automatic path (Create,
  // Edit-accept's resolveInvalidPlacement) ever freezes/protects a task
  // because of this flag. The ONE place it gates real behavior is Optimize's
  // "retainManual" mode (explicit user opt-in): tasks with this flag set are
  // locked at their current slot for that one repack, regardless of validity.
  manuallyMoved Boolean @default(false)
  scheduledStartTime DateTime? // assigned by the EDF engine
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-user labels (implicit many-to-many).
  tags Tag[]

  events TaskEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, deadline])
  @@index([userId, status])
  @@index([userId, scheduledStartTime])
}

enum TaskEventType {
  CREATE
  MOVE // user dragged to another slot/day
  RESIZE
  KEEP // user left an EDF suggestion in place (completed in its suggested slot) — positive signal
  COMPLETE // outcome: completed in its slot
  ABANDON // outcome: deadline expired unresolved (emitted by the overdue sweep)
  RESCHEDULED // task auto-repositioned as collateral in someone else's cascadeReschedule (not a user drag)
}

model TaskEvent {
  id          BigInt        @id @default(autoincrement())
  eventType   TaskEventType
  oldSnapshot Json? // { scheduledStartTime, durationMinutes }; null on CREATE
  newSnapshot Json
  rewardScore Float         @default(1.0) // Phase-3 signal
  occurredAt  DateTime      @default(now())
  // Groups every RESCHEDULED TaskEvent one multi-task batch wrote — today
  // that's SchedulerService.optimizeWindow (the explicit Optimize action) or
  // resolveInvalidPlacement (Edit-accept's single-task resolve) — so the
  // whole batch can be undone atomically via SchedulerService.undoBatch /
  // POST /tasks/reschedule/undo/:batchId. Null for events not written as
  // part of an undoable batch (e.g. CREATE, MOVE, RESIZE, COMPLETE).
  batchId     String?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String // denormalized for partition/range queries
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([taskId])
  // Serves `undoBatch`: every TaskEvent written by one narrowResolve cascade.
  @@index([userId, batchId])
}

model File {
  id           String   @id @default(uuid())
  originalName String
  filename     String
  path         String
  mimetype     String
  size         Int
  userId       String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

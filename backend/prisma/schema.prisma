generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(30)
  email     String   @unique @db.VarChar(30)
  createdAt DateTime @default(now())
  timezone  String   @db.VarChar(50)

  // Relations
  tasks      Task[]
  categories Category[]
}

model Task {
  id            String    @id @default(uuid())
  title         String
  duration      Int
  priority      Int       @default(3) // 1–3 (lower = more important)
  fixedStart    Int? // minutes since midnight, absolute start
  earliestStart Int? // earliest allowed start
  latestEnd     Int? // latest allowed end
  deadline      DateTime?
  mandatory     Boolean   @default(true)
  splittable    Boolean   @default(false)
  maxSplits     Int       @default(1)
  energyLevel   Int       @default(1) // 1–3
  userId        String
  categoryId    String

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  schedules Schedule[]

  // relations
  prerequisites Task[] @relation("TaskPrerequisites")
  dependentOn   Task[] @relation("TaskPrerequisites")
}

model Schedule {
  date  DateTime @db.Date
  start DateTime @db.Time()
  end   DateTime @db.Time()
  split Int      @db.SmallInt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([split, taskId])
}

model Constraints {
  id                 String  @id @default(uuid())
  minGapBetweenTasks Int     @default(0)
  maxDailyLoad       Int     @default(1440)
  batchSimilarTasks  Boolean @default(true)

  availableHours AvailableHour[]
  energyBlocks   EnergyBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AvailableHour {
  id    String @id @default(uuid())
  start Int // minutes since midnight
  end   Int

  constraints   Constraints @relation(fields: [constraintsId], references: [id])
  constraintsId String
}

model EnergyBlock {
  id          String @id @default(uuid())
  energyLevel Int // 1–3
  start       Int
  end         Int

  constraints   Constraints @relation(fields: [constraintsId], references: [id])
  constraintsId String
}

model Category {
  id     String @id @default(uuid())
  name   String
  userId String

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]
}

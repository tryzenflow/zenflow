generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  engineType    = "binary"
  binaryTargets = "native"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  VI_VN @map("vi-VN")
  EN_US @map("en-US")
}

model User {
  id       String   @id @default(uuid())
  name     String   @db.VarChar(60)
  email    String   @unique @db.VarChar(255)
  timezone String   @default("Asia/Saigon") @db.VarChar(50)
  lang     Language @default(VI_VN)

  /// Reminder lead time (minutes) applied to new sessions that omit `reminders`; 0 = none.
  defaultReminderMinutes Int @default(10)

  /// When the user finished (or skipped through) first-run onboarding; null = not yet. Set once, server-side.
  onboardedAt DateTime?

  /// User intent for native push (Settings toggle / OS-permission denial, set by mobile). Gates push fan-out only; in-app/SSE unaffected.
  allowNotifications Boolean @default(true)

  /// Getting-started checklist steps done, plus `checklist-hidden` (`TIP_IDS` in @zenflow/shared); append-only.
  seenTips String[] @default([])

  preferenceMatrix          Float[]   @default([])
  preferenceMatrixDecayedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions      Session[]
  files         File[]
  sessionEvents SessionEvent[]
  tags          Tag[]

  encryptionKeys UserEncryptionKey[]
  devices        UserDevice[]
  sessionSeries  SessionSeries[]
  integrations   Integration[]
  notifications  Notification[]
  slotProposals  SlotProposal[]

  banditArmStates BanditArmState[]

  // Issue #56: which portal sections / Moodle courses this student is
  // confirmed in, so an ingestion pass can be served from the shared
  // occurrence cache without walking their timetable.
  portalSectionEnrollments PortalSectionEnrollment[]
  lmsCourseEnrollments     LmsCourseEnrollment[]
}

/**
 * Time-of-day arms for the Disjoint LinUCB scheduler
 * (`docs/adr/0001-linucb-model-design.md` §2). Half-open, lower-inclusive
 * local-wall-clock bands: EARLY_MORNING [00:00,06:00), MORNING [06:00,11:00),
 * MIDDAY [11:00,14:00), AFTERNOON [14:00,17:00), EVENING [17:00,20:00),
 * NIGHT [20:00,24:00).
 */
enum SchedulingArm {
  EARLY_MORNING
  MORNING
  MIDDAY
  AFTERNOON
  EVENING
  NIGHT
}

/**
 * Per-(user, arm) LinUCB state. `A` is the row-major `d·d` design matrix, `b`
 * the length-`d` response vector (`d = 22`, `FEATURE_DIM` in `@zenflow/shared`).
 * The Python bandit service is stateless: the backend loads these, passes them
 * in each `/predict` / `/update` payload and persists what comes back. Rows are
 * lazily created at the ridge prior (`A = λI`, `b = 0`) on first use; `version`
 * is a best-effort optimistic-concurrency guard for the delayed-feedback writer.
 */
model BanditArmState {
  userId    String
  arm       SchedulingArm
  A         Float[]       @default([])
  b         Float[]       @default([])
  version   Int           @default(0)
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, arm])
}

// Per-(user, provider) data-encryption key, itself protected by a per-provider
// server-held master key kept outside the DB
// (MASTER_<provider>_ENCRYPTION_KEY_V<masterKeyVersion>).
model UserEncryptionKey {
  id               String              @id @default(uuid())
  provider         IntegrationProvider
  // DEK version — bumped when the per-user key itself is rotated. Independent of
  // `masterKeyVersion`: rotating the DEK re-encrypts this user's Integration
  // rows; rotating the master key only re-wraps `key` below.
  version          Int
  // Which MASTER_<provider>_ENCRYPTION_KEY_V<n> env secret wrapped `key`.
  masterKeyVersion Int
  // `key` is the DEK AFTER being wrapped (AES-256-GCM) under that master key;
  // `iv` and `authTag` belong to that wrap operation, not to any credential.
  // The plaintext DEK never touches the DB.
  key              String
  iv               String
  authTag          String
  algorithm        String
  createdAt        DateTime            @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, version])
  @@index([userId])
  @@index([userId, provider, version(sort: Desc)])
}

enum DevicePlatform {
  IOS
  ANDROID
}

// Native push registration (FCM on Android, APNs on iOS); one row per device
// so a user can have multiple. `pushToken` is the raw provider token — an
// opaque string, unique per (app install, device, provider), so it is the
// natural key: registration upserts on it and a device re-homes to whoever
// logs in on it (the `userId` is rewritten on conflict).
model UserDevice {
  id         String         @id @default(uuid())
  platform   DevicePlatform
  pushToken  String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lastSeenAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Implicit many-to-many with Session.
  sessions Session[]

  @@unique([userId, name])
  @@index([userId])
}

enum SessionType {
  TASK
  ASSIGNMENT
  EXAM
  LECTURE
  DND // do not disturb (non-study time to exclude from scheduling)
}

enum SessionSource {
  USER
  LMS
  PORTAL
}

model Session {
  id              String        @id @default(uuid())
  title           String
  note            String?
  // Where the session takes place — a room / building / campus string. Free
  // text for a user-pinned session; for an ingested fixed session the DLU
  // watchers write the upstream room here (portal `PhongThi` / `RoomID`,
  // Moodle event `location`). Optional and never used by the scheduler.
  location        String?
  durationMinutes Int // positive multiple of 15
  deadline        DateTime? // required for TASK; null for fixed types (ASSIGNMENT/EXAM/LECTURE/DND)
  type            SessionType   @default(TASK)
  source          SessionSource @default(USER)

  conflict Boolean @default(false)

  // Soft-delete flag. A user-initiated delete sets this instead of removing
  // the row, so an ingested item's still-unique `externalKey` lets the
  // materializer recognize "the student deleted this" on the next re-fetch
  // and skip recreating it, rather than the row disappearing and silently
  // coming back. Every read that feeds scheduling or calendar display filters
  // `deleted: false`; the materializer's own `userId_externalKey` lookup is
  // the deliberate exception (it must see a soft-deleted row on purpose).
  deleted Boolean @default(false)

  scheduledStartTime DateTime? // fixed types (ASSIGNMENT/EXAM/LECTURE/DND) are always scheduled; TASK is placed by the engine
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stamped on every user move/resize of a scheduled TASK; the RETAINED sweep
  // treats `lastMovedAt == null` as "never moved".
  lastMovedAt DateTime?
  // Idempotency guard for the RETAINED sweep — set once the session has elapsed
  // unmoved and its RETAINED SessionEvent has been written.
  retainedAt  DateTime?

  // Two-consecutive-run confirmation gate for ingested rows (materializer.service.ts).
  // Null means "created but not yet confirmed by a second watcher run" — the
  // item is already on the calendar, but its "new item" notification is held
  // back and a run that stops seeing it hard-deletes the row outright rather
  // than soft-deleting it, since it was never a real, user-facing item. Set to
  // the confirming run's `now` the first time a second run also sees it; from
  // then on the row is a normal ingested session eligible for update/removal
  // notifications. Always null for a user-created (non-ingested) session.
  syncConfirmedAt DateTime?
  // Set to a run's `now` the first time a *confirmed* item is missing from
  // that run's upstream listing — one miss so far, not yet a removal. Cleared
  // back to null the moment the item reappears (the miss streak broke, no
  // notification either way). A second consecutive miss (still set on the next
  // run) is what actually soft-deletes the row and raises the removal
  // notification. Always null for a user-created (non-ingested) session.
  syncMissedAt    DateTime?

  // Per-user labels (implicit many-to-many).
  tags Tag[]

  events SessionEvent[]

  seriesId String? // for series with rrule, only create a representative session and filter sessions belonging to a series whose rrule covers a particular day range
  series   SessionSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  // Denormalized convenience fields for cheap per-row rendering alongside seriesId.
  sessionIndex Int?
  sessionTotal Int?

  // Stable identity of the upstream DLU item this session mirrors — null for
  // every user-created session. Format is "<source>:<kind>:<upstream id>":
  //
  //   "lms:assign:<instance>"        Moodle assignment  (mod_assign instance)
  //   "lms:quiz:<instance>"          Moodle quiz        (mod_quiz instance)
  //   "portal:exam:<Examination>"    portal exam row
  //   "portal:lecture:<ScheduleStudyUnitID>:<YYYY-MM-DD>:<PeriodID>"
  //                                  one timetable meeting
  //
  // The formats are built and documented in
  // `src/ingestion/core/external-key.ts` — that file, not this comment, is the
  // single source of truth, and it carries the rule for deciding what belongs
  // inside a key (identity) versus outside it (an in-place update).
  //
  // The lecture key was "portal:meeting:<WeekScheduleID>" before issue #56.
  // The portal mints WeekScheduleID per (section, student), which made the key
  // student-specific and the cross-student occurrence cache impossible — a
  // cached section occurrence cannot mint another student's id. The three
  // components above are all properties of the section's meeting instead.
  // Pre-#56 rows are renamed in place by MaterializerService.adoptLegacyKey
  // the next time a walk sees them; the alias can be dropped one term after
  // deploy.
  //
  // The LMS half deliberately keys on the activity `instance`, never the
  // calendar event id: one quiz emits two events (open + close) with different
  // ids but one instance, and a teacher re-creating a due date mints a fresh
  // event id for the same activity.
  //
  // This is the ingestion idempotency guard. The watchers run on a cron and
  // re-fetch the same window every tick, so every write upserts on
  // [userId, externalKey]; without the unique constraint each tick would
  // duplicate the student's whole calendar.
  externalKey String?

  // The portal's ScheduleStudyUnitID for a portal-ingested LECTURE — one
  // meeting's course section, shared by every meeting of that class across
  // the term. Null for anything that isn't a portal-ingested LECTURE
  // (including a user-created recurring LECTURE via rrule). There is no
  // SessionSeries linking these rows (each meeting is its own flat Session),
  // so this is the grouping key for bulk delete/scope operations on a
  // timetable class ("this and following" / "all occurrences" —
  // `DELETE /sessions/timetable-group/:sessionId[/from]`).
  scheduleStudyUnitId String?

  // The Moodle course.id of an LMS-ingested ASSIGNMENT/EXAM — the symmetric
  // partner of scheduleStudyUnitId above, and the lookup key the issue-#56
  // occurrence fan-out uses to find every session belonging to a course whose
  // cached items changed. Null for everything else.
  //
  // Nullable and self-healing rather than backfilled by a script: the
  // materializer repairs a missing back-link on the next run that sees the
  // item, and deliberately does NOT count the repair as an upstream change —
  // a back-link is invisible to the student, so folding it into
  // differsFromUpstream would mark every ingested row "updated" on the first
  // run after deploy and announce an entire calendar as changed.
  lmsCourseId Int?

  reminders     SessionReminder[]
  notifications Notification[]
  slotProposals SlotProposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, externalKey])
  @@index([userId, deadline])
  @@index([userId, scheduledStartTime])
  @@index([userId, seriesId, createdAt(sort: Asc)])
  @@index([userId, scheduleStudyUnitId])
  @@index([userId, lmsCourseId])
}

model SessionSeries {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  type      SessionType @default(DND) // recurring DND/ASSIGNMENT/EXAM/LECTURE (via rrule), or TASK (multi-sitting via sessionCount)
  deadline  DateTime? // null for a recurring series; the shared deadline for a TASK series
  rrule     String? // the recurrence rule — set for a recurring series, null for a TASK series
  exdates   String[]    @default([]) // ISO instants of individually-deleted occurrences (rrule series only)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessions Session[]

  @@index([userId])
}

// Excludes DND; at most twice per session (enforced in DTO + RemindersService).
// Armed as an in-memory SchedulerRegistry timeout keyed by `reminder:<id>`
// (see src/reminders/). For a recurring fixed series the row hangs off the
// representative session and applies to every occurrence.
model SessionReminder {
  id                  String    @id @default(uuid())
  remindBeforeMinutes Int       @default(15)
  // Start instant of the occurrence this reminder last fired for — dedupes
  // firing across restarts / re-arms and lets a recurring series fire once
  // per occurrence. Null until first fired.
  firedForStart       DateTime?

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum SlotProposalEvent {
  CREATE
  DEADLINE_CHANGE
  MANUAL_RESCHEDULE
}

enum SchedulingModel {
  HEURISTIC
  LINUCB
}

enum SlotProposalFeedback {
  LIKE
  DISLIKE
}

// A/B experiment record for the heuristic-vs-model scheduling comparison
// (`docs/scheduler/ab-testing.md`). Columns only for now — nothing writes this
// table yet; the ExperimentService / randomizer / pairwise + feedback UI are a
// later phase.
enum PlacementSource {
  PYTHON
  TS_FALLBACK
}

model SlotProposal {
  id                String            @id @default(uuid())
  experimentId      String
  event             SlotProposalEvent
  primaryPolicy     SchedulingModel // the randomized 50/50 assignment for this event
  randomizationSeed String
  observationCount  Int               @default(0) // user's reward-event count at proposal time → stable cold-start buckets

  heuristicProposal Json // proposed schedule / day-repack diffs
  modelProposal     Json? // model proposal — null until the model is wired
  modelVersion      String?
  proposedStartTime DateTime? // primary policy's concrete pick for this session
  appliedStartTime  DateTime?

  // The length-`d` LinUCB context vector for the selected day and the arm
  // behind the chosen slot, kept so a delayed MOVE / RETAINED reward can call
  // `/update` for the right arm (`docs/adr/0001-linucb-model-design.md` §9).
  // Empty / null when the primary policy was the heuristic.
  featureVector    Float[]        @default([])
  selectedArm      SchedulingArm?
  // Applied LinUCB slot-score weights (`wL` = 1, `wS` = proximity-scaled
  // stability, `services/bandit/src/core/slot_score.py::stability_weight`);
  // null when the primary policy was the pref-only heuristic.
  linucbWeight     Float?
  stabilityWeight  Float?

  // Provenance (ADR-0003): which implementation produced the placement, so A/B
  // analysis can exclude degraded (frozen-TS-fallback) events.
  placementSource PlacementSource @default(PYTHON)
  degradedReason  String? // "timeout" | "breaker_open" | "connect" | "http_5xx" | "version" | "disabled"

  sessionEvents SessionEvent[]

  firstModifiedAt             DateTime? // outcome signals (denormalized, maintained by a later phase)
  firstModificationType       SessionEventType?
  acceptedWithoutModification Boolean?

  pairwiseShown     Boolean          @default(false) // pairwise comparison (later)
  pairwisePositions Json?
  chosenByUser      SchedulingModel?

  feedback   SlotProposalFeedback? // explicit 👍/👎 (later)
  feedbackAt DateTime?

  timestamp DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([experimentId])
}

enum SessionEventType {
  CREATE
  MOVE // user drag or resize of a scheduled TASK (negative signal)
  RETAINED // session elapsed without ever being moved (positive signal)
  SYSTEM_MOVE // scheduler-initiated move (displacement / conflict reschedule): reward 0, no preference update
}

/// Range-partitioned by month on `occurredAt` (hand-written migration, ADR-0016); children are `SessionEvent_YYYY_MM`.
model SessionEvent {
  id                  BigInt           @default(autoincrement())
  eventType           SessionEventType
  oldSnapshot         Json? // { scheduledStartTime, durationMinutes, tags[], type }; null on CREATE/RETAINED
  newSnapshot         Json
  rewardScore         Float            @default(0.0) // CREATE 0 · MOVE -1 · RETAINED +1
  dragDistanceMinutes Int? // signed (new − old start); null unless MOVE — for graded reward later
  policy              SchedulingModel? // attribution once a model is live
  // The `SessionSeries.id` shared by the N sittings placed in one
  // `sessionCount > 1` create call — groups their CREATE events so the batch
  // can be reverted (delete the series) as one action. Null for a single-sitting
  // create. Plain scalar, not a relation: it must survive the series' deletion.
  seriesId            String?
  occurredAt          DateTime         @default(now())

  // Nullable + SetNull so RETAINED / observation-count history survives a
  // session deletion (needed for cold-start bucketing).
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // The LinUCB SlotProposal this MOVE / RETAINED delivered a delayed reward
  // for, if any (`docs/adr/0001-linucb-model-design.md` §9).
  slotProposalId String?
  slotProposal   SlotProposal? @relation(fields: [slotProposalId], references: [id], onDelete: SetNull)

  userId String // denormalized for partition/range queries
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([id, occurredAt])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([sessionId])
  @@index([slotProposalId])
  @@index([seriesId])
}

model File {
  id           String   @id @default(uuid())
  originalName String
  filename     String
  path         String
  mimetype     String
  size         Int
  userId       String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum IntegrationProvider {
  LMS
  PORTAL
}

// Encrypted LMS/portal credentials, one row per (userId, provider).
model Integration {
  id                   String              @id @default(uuid())
  provider             IntegrationProvider
  // `encryptedCredentials` is the JSON credential blob encrypted (AES-256-GCM)
  // under the user's current UserEncryptionKey; `iv` and `authTag` belong to
  // that operation. `encryptionVersion` tracks which UserEncryptionKey.version
  // was used so a rotated key can still decrypt older rows.
  encryptedCredentials String
  iv                   String?
  authTag              String?
  encryptionVersion    Int
  lastVerifiedAt       DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lmsSyncJobs   LmsSyncJob[]
  portalApiJobs PortalAPIJob[]

  // Issue #56: one independent cadence per sync kind, and the confirmed
  // enrolment sets discovery writes for the walk passes to read.
  schedules         IngestionSchedule[]
  portalEnrollments PortalSectionEnrollment[]
  lmsEnrollments    LmsCourseEnrollment[]

  @@unique([userId, provider])
  @@index([provider, userId])
  @@index([encryptionVersion(sort: Desc)])
}

model Notification {
  id                 String    @id @default(uuid())
  sentAt             DateTime  @default(now())
  readAt             DateTime?
  actionTakenAt      DateTime?
  // Stable machine-readable slug ("assignment.created", "lecture.removed",
  // "sync_conflict.exam", …) a client can switch on without pattern-matching
  // the free-text `title`/`content` below, which are for display only.
  // Encodes both the created/updated/removed/conflict classification and the
  // assignment/exam/lecture/reminder category (see `notificationEventKind` /
  // `notificationCategory` in @zenflow/shared) — no separate `topic`/
  // `eventType` columns for those, so there is one field to keep in sync.
  eventName          String
  title              String
  content            String
  // The fixed end instant of the session behind this row (start + duration) —
  // an ASSIGNMENT/EXAM/LECTURE is always scheduled, so this is the "due" / "at"
  // time the inbox shows. Null for grouped rows and for drops (no one session).
  eventEndsAt        DateTime?
  // A CONFLICT row's (see `notificationEventKind`) user's flexible tasks the
  // sync landed on top of.
  conflictSessionIds String[]  @default([])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, sentAt(sort: Desc)])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Per-run job tracking for the LMS watcher. Named "sync", not "crawl":
// the watcher reads Moodle's JSON calendar API, it does not scrape pages.
model LmsSyncJob {
  id        String    @id @default(uuid())
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  items LmsSyncJobItem[]
}

model LmsSyncJobItem {
  id           String    @id @default(uuid())
  url          String
  status       JobStatus @default(PENDING)
  attempt      Int       @default(0)
  // Mirrors PortalAPIJobItem field-for-field on purpose: while ingestion is
  // still being validated against the live LMS, having the raw upstream JSON
  // sitting on the item row is what makes a bad parse diagnosable after the
  // fact, without re-running the fetch against a moving target.
  statusCode   Int?
  responseBody String?
  createdAt    DateTime  @default(now())

  lmsSyncJobId String
  lmsSyncJob   LmsSyncJob @relation(fields: [lmsSyncJobId], references: [id], onDelete: Cascade)

  @@index([lmsSyncJobId])
}

// Same job-tracking shape as LmsSyncJob/LmsSyncJobItem, for the portal API poller.
model PortalAPIJob {
  id        String    @id @default(uuid())
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  items PortalAPIJobItem[]
}

model PortalAPIJobItem {
  id           String    @id @default(uuid())
  url          String
  status       JobStatus @default(PENDING)
  attempt      Int       @default(0)
  statusCode   Int?
  responseBody String?
  createdAt    DateTime  @default(now())

  portalApiJobId String
  portalApiJob   PortalAPIJob @relation(fields: [portalApiJobId], references: [id], onDelete: Cascade)

  @@index([portalApiJobId])
}

// ---------------------------------------------------------------------------
// DLU course identity — two independent catalogs.
//
// A Moodle course (LmsCourse) and a portal timetable section (PortalSection)
// describe the same real-world class, but there is deliberately NO correlation
// table, no foreign key and no mapping between them: the two systems share no
// identifier, their names differ (abbreviations, diacritics, group suffixes),
// and every join we could build would be a fuzzy string match that is wrong
// often enough to corrupt a student's calendar. Nothing in the ingestion path
// needs the join either — an LMS item is scheduled from LMS data alone and a
// timetable meeting from portal data alone.
//
// Both tables are plain, cross-user reference data, deduped on the upstream id.
// They exist so an ingested Session can be traced back to a human-readable
// course without re-fetching, and so the later shared cross-student catalog
// (deferred) has somewhere to land.
// ---------------------------------------------------------------------------

// A Moodle course, as it appears in the `course` block of the LMS calendar
// (core_calendar_get_calendar_monthly_view) response.
model LmsCourse {
  id          String  @id @default(uuid())
  lmsCourseId Int     @unique // Moodle course.id, e.g. 90001 — the upstream identity
  fullName    String
  shortName   String?

  // ── issue #56 cache coverage ────────────────────────────────────────────
  // When some student's walk last re-read this course's items, and the last
  // instant that walk covered. Both halves are needed: "refreshed 10 minutes
  // ago" is not fresh if it only covered up to last Friday.
  //
  // A stamp on the catalog row rather than an aggregate over
  // LmsCourseOccurrence.lastSeenAt, because freshness is a property of the
  // catalog entry, there is exactly one row per course already, and a
  // max(lastSeenAt) groupBy in the claim path cannot express the window at all.
  occurrencesRefreshedAt DateTime?
  occurrencesThroughDate DateTime?

  // ── issue #56 divergence guard ──────────────────────────────────────────
  // Moodle can show two students different things under one shared key: a
  // per-user or per-group due-date override, or a group-restricted activity
  // that is simply absent for everyone else. So a Moodle change is only fanned
  // out once TWO different students have each seen the same before -> after
  // transition. These three fields are that agreement state — see
  // `observeUnit` in ingestion/core/occurrences.ts. The fingerprint is of the
  // last walker's view of this course; `…By` is who; `…Prior` is what that
  // walker saw before it (equal to the fingerprint once fanned out).
  occurrencesFingerprint      String?
  occurrencesFingerprintBy    String?
  occurrencesPriorFingerprint String?

  occurrences LmsCourseOccurrence[]
  enrollments LmsCourseEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One student-portal course section — a specific offering of a curriculum unit
// in one term, taught by one teacher to one group in one room.
model PortalSection {
  id                  String  @id @default(uuid())
  // The portal's ScheduleStudyUnitID, e.g. "99910AB100101". Composite by
  // construction (term + curriculum + group), but treated as an opaque
  // upstream identity — we never parse it.
  scheduleStudyUnitId String  @unique
  curriculumId        String? // "10AB1001"
  curriculumName      String // "Môn học Mẫu Một"
  yearStudy           String // academic year, "2026-2027"
  termId              String // "HK01" | "HK02" | "HK03"
  groupNo             String? // "Nhóm: 01"
  teacherName         String? // FullName
  roomId              String? // RoomID, "X01.01"
  buildingName        String? // "A27"
  campusName          String? // CampusName / Address

  // ── issue #56 cache coverage ────────────────────────────────────────────
  // When some student's walk last re-read this section's meetings, and the
  // last date that walk covered — see the note on LmsCourse for why both
  // halves live here rather than being aggregated off the occurrence rows.
  //
  // timetableThroughDate is a date, not an ISO week number: HK02 straddles New
  // Year and week numbers wrap 52 (or 53) -> 1, so "covered through week N" is
  // not a numeric comparison. semester.ts walks Mondays for the same reason.
  timetableRefreshedAt  DateTime?
  timetableThroughDate  DateTime?

  occurrences     PortalSectionOccurrence[]
  enrollments     PortalSectionEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The watcher fetches a whole term at a time, so (yearStudy, termId) is the
  // access path for every refresh and every stale-section sweep.
  @@index([yearStudy, termId])
}

// ---------------------------------------------------------------------------
// Issue #56 — rolling ingestion cadence + cross-student occurrence cache.
//
// Two problems, two halves of this block.
//
// 1. CADENCE. Each watcher used to be one plain @Cron whose firing swept the
//    entire student population in a single instant: the same total volume, but
//    concentrated in one few-minute window every day. Against a real
//    university portal a burst of hundreds of logins back to back is not what
//    organic traffic looks like. `IngestionSchedule` gives every
//    (integration, kind) pair its own `nextDueAt`, and a short-interval ticker
//    claims only the most-overdue few — the same daily volume, spread
//    continuously. One `Integration.updatedAt` could not represent this:
//    discovery and the walk for one student are independently due.
//
// 2. VOLUME. Every student re-fetched the same term-scoped resource. A
//    measured 150-student run issued 6,395 upstream requests against 21
//    distinct resources — ~305x redundancy. The `*Occurrence` tables hold each
//    real, dated activity once, keyed by the SECTION or COURSE rather than by
//    the student, so whichever student is claimed first warms the data for
//    every classmate.
//
// The `*Enrollment` tables are the prerequisite: they record which sections and
// courses a student is CONFIRMED in, discovered from DKHP's registration
// history and Moodle's enrolled-courses call, so a walk can be
// skipped without having walked. Fan-out only ever reads occurrences for
// sections in that student's own confirmed set — no schedule is ever inferred
// by copying another student's.
// ---------------------------------------------------------------------------

// The five independently-scheduled kinds of sync work.
//
// Discovery is split from the walk because they want different cadences and
// different failure handling: discovery answers "which sections is this
// student in" (cheap, ~3 requests, once a day) and the walk answers "what does
// that section's week look like" (expensive, up to ~22 requests). Splitting
// them is also what lets the walk be skipped at all.
enum IngestionSyncKind {
  PORTAL_DISCOVERY // DKHP getAllRegistHistory, once per term -> confirmed ScheduleStudyUnitID set
  LMS_DISCOVERY // enrolled-courses      -> confirmed Moodle course id set
  PORTAL_TIMETABLE // DrawingStudentSchedules, one request per remaining ISO week
  PORTAL_EXAM // /api/student/exam, a plain fetch of the term (no cache, no fan-out)
  LMS_CALENDAR // monthly calendar view, MONTHS_PER_RUN requests
}

// One (integration, kind) pair's independent cadence.
model IngestionSchedule {
  id   String            @id @default(uuid())
  kind IngestionSyncKind

  // The claim ordering key AND the compare-and-set token.
  //
  // A tick reads the most-overdue rows (nextDueAt <= now, oldest first) and
  // then claims each with `updateMany where { id, nextDueAt: theValueItRead }`.
  // An overlapping tick that read the same row loses the race and gets
  // count 0, so no target is ever processed twice — no advisory lock and no
  // raw SQL. See IngestionScheduleService.claimDue.
  //
  // Stamped forward on CLAIM, not on completion: a pass that throws must still
  // have moved its due time, or the next tick re-claims the same failing
  // student forever and starves everyone queued behind it.
  nextDueAt     DateTime
  lastClaimedAt DateTime?
  lastRunAt     DateTime?

  // The last pass that finished with every upstream request succeeding. For a
  // discovery kind this is the freshness stamp the walk passes gate on, which
  // is why a FAILED discovery pass must leave it untouched: the failure mode of
  // "discovery is down" has to be "we do more work", never "we skip a student".
  lastSuccessAt       DateTime?
  // PORTAL_DISCOVERY only: the "<year>/<term>" the last clean pass covered, ""
  // before any. The timetable gate requires it to equal the current term, and
  // a mismatch makes the row due ahead of its period (a new term).
  lastSuccessTerm     String    @default("")
  consecutiveFailures Int       @default(0)

  // How many consecutive passes were served entirely from the occurrence cache.
  // Forces a full live walk every INGESTION_FULL_WALK_EVERY passes, so no
  // student can drift indefinitely on a cache nobody is refreshing.
  cacheHitStreak Int @default(0)

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([integrationId, kind])
  // The claim query, verbatim: WHERE kind = ? AND nextDueAt <= now ORDER BY nextDueAt.
  @@index([kind, nextDueAt])
}

// A student's confirmed registration in one portal section.
//
// Rows, not a String[] column on the integration, for two reasons: fan-out
// needs the reverse lookup "every confirmed student of section X", which an
// array cannot index; and a per-row droppedAt is what distinguishes a
// registration the student actually withdrew from from one that is missing only
// because a discovery pass failed.
model PortalSectionEnrollment {
  id                  String @id @default(uuid())
  userId              String
  integrationId       String
  scheduleStudyUnitId String

  // The term the set belongs to. A student's confirmed set is per-term by
  // construction, and a new term must not silently inherit the old one's.
  yearStudy String
  termId    String

  // Last discovery pass that listed this registration.
  discoveredAt DateTime
  // First SUCCESSFUL pass that no longer listed it — a dropped or withdrawn
  // registration. Soft, like Session.deleted: a reappearance clears it rather
  // than inserting a second row.
  droppedAt    DateTime?

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  section     PortalSection @relation(fields: [scheduleStudyUnitId], references: [scheduleStudyUnitId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scheduleStudyUnitId])
  // Fan-out direction: who else is confirmed in this section.
  @@index([scheduleStudyUnitId, droppedAt])
  // Walk direction: which sections may this student be served from cache.
  @@index([userId, droppedAt])
}

// A student's confirmed enrolment in one Moodle course.
model LmsCourseEnrollment {
  id            String @id @default(uuid())
  userId        String
  integrationId String
  lmsCourseId   Int

  // The three signals the current-term filter reads, stored so a disagreement
  // between them is inspectable after the fact rather than only in a log line.
  // Moodle's `classification: "allincludinghidden"` returns a student's ENTIRE
  // enrolment history, so some filter is unavoidable.
  courseCategory String?
  startDate      DateTime?
  hidden         Boolean   @default(false)

  // The filter's verdict. ADVISORY while INGESTION_LMS_TERM_FILTER=shadow:
  // recorded and metered but gating nothing, because the issue requires the
  // filter be validated against a real account before it can cause a skip.
  currentTerm Boolean @default(true)

  discoveredAt DateTime
  droppedAt    DateTime?

  // This student's own last live view of the course — see
  // PortalSectionEnrollment.examsSeenFingerprint.
  seenFingerprint String?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  course      LmsCourse   @relation(fields: [lmsCourseId], references: [lmsCourseId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lmsCourseId])
  @@index([lmsCourseId, droppedAt])
  @@index([userId, droppedAt])
}

// One real, dated meeting of a portal section, shared by every student in it.
//
// The unique triple below is exactly the lecture externalKey
// (`src/ingestion/core/external-key.ts`), which is what lets a row here mint
// the key for any confirmed student without a fetch.
model PortalSectionOccurrence {
  id                  String @id @default(uuid())
  scheduleStudyUnitId String

  // The meeting day as the upstream row's own DLU_TZ wall clock, 'YYYY-MM-DD'.
  // A string rather than a DateTime on purpose: it is part of the identity, and
  // storing it as an instant would make the key depend on which timezone read
  // it back.
  meetingDate     String
  periodId        Int
  numberOfPeriods Int

  // The ISO week the row was fetched under (the portal's `tuan`), kept for
  // diagnosis: it is how you find which request produced a given row.
  isoWeek   Int
  yearStudy String
  termId    String

  // The resolved instant and length, on the 15-minute grid (invariant #3), so
  // the fan-out path never re-runs period-map.ts.
  startsAt        DateTime
  durationMinutes Int

  title       String
  roomId      String?
  teacherName String?

  // First fetch that saw this meeting, and the most recent one. lastSeenAt is
  // what freshness is measured against.
  firstSeenAt DateTime
  lastSeenAt  DateTime
  // Set by the first complete fetch of this week that no longer lists the
  // meeting — a cancelled class. Soft, so a re-listing is recognised as the
  // same meeting rather than a new one.
  canceledAt  DateTime?

  section PortalSection @relation(fields: [scheduleStudyUnitId], references: [scheduleStudyUnitId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleStudyUnitId, meetingDate, periodId])
  @@index([scheduleStudyUnitId, startsAt])
}

// One dated Moodle activity (assignment due date or quiz window), shared by
// every student enrolled in the course.
//
// Keyed on the full externalKey rather than the bare `instance` because an
// assignment and a quiz can carry the same instance number in different Moodle
// modules — the kind is part of the identity.
model LmsCourseOccurrence {
  id          String @id @default(uuid())
  lmsCourseId Int
  externalKey String @unique // "lms:assign:<instance>" | "lms:quiz:<instance>"

  // ASSIGNMENT or EXAM only — parse-lms.ts emits nothing else.
  type            SessionType
  startsAt        DateTime
  durationMinutes Int
  title           String
  note            String?
  location        String?

  firstSeenAt DateTime
  lastSeenAt  DateTime
  canceledAt  DateTime?

  course LmsCourse @relation(fields: [lmsCourseId], references: [lmsCourseId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lmsCourseId, startsAt])
}

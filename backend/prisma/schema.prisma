generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(30)
  email     String   @unique @db.VarChar(30)
  createdAt DateTime @default(now())
  timezone  String   @db.VarChar(50)

  // Relations
  tasks       Task[]
  categories  Category[]
  constraints Constraint[]
  files       File[]
}

model Task {
  id       String  @id @default(uuid())
  title    String
  note     String?
  duration Int
  priority Int     @default(3) // 1–3 (lower = more important)

  earliestStart Int?      @db.SmallInt
  latestEnd     Int?      @db.SmallInt
  deadline      DateTime?

  mandatory Boolean @default(true)
  maxSplits Int     @default(1)
  focus     Int     @default(1) // 1–3

  userId     String
  categoryId String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  schedules Schedule[]

  createdAt DateTime @default(now())

  repeatRules RepeatRule[]

  // relations
  prerequisites Task[] @relation("TaskPrerequisites")
  dependentOn   Task[] @relation("TaskPrerequisites")
}

model Schedule {
  date  DateTime  @db.Date
  start DateTime?
  end   DateTime?
  split Int       @db.SmallInt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, split, date])
}

model Constraint {
  id                 String  @id @default(uuid())
  minGapBetweenTasks Int     @default(0)
  maxDailyLoad       Int     @default(1440)
  batchSimilarTasks  Boolean @default(true)
  weekday            Int     @default(0) @db.SmallInt // 0=Sun, 1=Mon, ..., 6=Sat

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  focusBlocks FocusBlock[]

  @@unique([userId, weekday])
}

model FocusBlock {
  id    String @id @default(uuid())
  level Int    @db.SmallInt // 1–3
  start Int    @db.SmallInt
  end   Int    @db.SmallInt

  constraint   Constraint @relation(fields: [constraintId], references: [id])
  constraintId String     @map("constraintsId")
}

model Category {
  id     String @id @default(uuid())
  name   String
  userId String

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name])
}

enum RepeatType {
  Daily
  Weekly
  Monthly
  Yearly
}

model File {
  id       String @id @default(uuid())
  filename String
  path     String
  mimetype String
  userId   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RepeatRule {
  id     String @id @default(uuid())
  task   Task   @relation(fields: [taskId], references: [id])
  taskId String

  type           RepeatType // 'daily' | 'weekly' | 'monthly' | 'yearly'
  frequency      Int // every N units
  weekday        Int[] // e.g., [1,3,5] for Mon/Wed/Fri
  month          Int?
  day            Int?
  weekdayOrdinal Int? // e.g., 1=first, -1=last
  skipWeekends   Boolean?
  firstWorkday   Boolean? // for monthly repeat
  lastWorkday    Boolean?
  until          DateTime?

  createdAt DateTime @default(now())
}

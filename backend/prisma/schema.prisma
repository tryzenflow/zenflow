generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  engineType    = "binary"
  binaryTargets = "native"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  name     String @db.VarChar(60)
  email    String @unique @db.VarChar(255)
  timezone String @default("UTC") @db.VarChar(50)

  // Working window (see docs/objects.md). Minutes from midnight + ISO weekdays.
  workStart Int   @default(540) // 09:00
  workEnd   Int   @default(1020) // 17:00
  workDays  Int[] @default([1, 2, 3, 4, 5]) // 1=Mon … 7=Sun

  // Flat 168-int SIGNED preference matrix (7 days × 24 one-hour buckets).
  // Written as Phase-2 telemetry: keeps/moves-toward increment a cell (+1),
  // moves-away decrement it (-1); an empty cell is 0 (neutral). Seeded lazily.
  preferenceMatrix Int[] @default([])

  // When the daily decay cron last applied exponential time-decay to
  // `preferenceMatrix` (see MatrixDecayService). Null until the first decay
  // pass; the cron treats null as "no elapsed days" and only stamps the time.
  preferenceMatrixDecayedAt DateTime?

  // Duration-corrector UX mode (auto | ask | never), surfaced on the user
  // profile and editable via preferences/onboarding. `never` still LEARNS bias.
  durationAdjustmentMode DurationAdjustmentMode @default(auto)

  roleArchetypeId    String? // Phase-4 cold-start cluster id
  onboardingComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks      Task[]
  files      File[]
  taskEvents TaskEvent[]
  tags       Tag[]
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Implicit many-to-many with Task.
  tasks Task[]

  @@unique([userId, name])
  @@index([userId])
}

enum TaskStatus {
  PENDING
  DONE // completed
  ABANDONED // deadline passed while still PENDING (set by the overdue sweep)
}

// How the per-tag duration corrector surfaces its adjustment to the user:
//   auto  → apply the corrected duration + show an undoable toast
//   ask   → prompt before applying (accept corrected / keep estimate)
//   never → never apply (still LEARNS bias for the heatmap/analytics)
// Mirrors @zenflow/shared DurationAdjustmentMode. Lowercase string enum, like
// the ViewMode precedent.
enum DurationAdjustmentMode {
  auto
  ask
  never
}

// Calendar view a task was created from. Records the period (day/week/month)
// whose working hours bound a flexible, no-deadline task: such a task may not
// roll past the end of this period (see Task.view). Mirrors @zenflow/shared
// ViewMode.
enum ViewMode {
  day
  week
  month
}

model Task {
  id              String     @id @default(uuid())
  title           String
  note            String? // rich-text (TipTap) — carried over from v1
  durationMinutes Int // positive multiple of 15
  deadline        DateTime?
  fixed           Boolean    @default(false)
  startTime       Int        @default(0) // minutes from midnight; used when fixed
  status          TaskStatus @default(PENDING)
  conflict        Boolean    @default(false) // unplaced (no slot before deadline)

  // A flexible task the user manually dragged/resized. Like `fixed`, this makes
  // the task an anchor: the EDF re-pack keeps its slot and treats it as occupied
  // space instead of re-ordering it by deadline.
  manuallyMoved Boolean @default(false)

  // Per-task lower bound for the EDF packer (a UTC instant = start-of-day of the
  // day the task was created from, in the user's tz). Only consulted for flexible
  // tasks with NO deadline: such a task lands on/after this day instead of the
  // first free slot from `now`. Deadline-bearing tasks ignore it (pure EDF from
  // now). Null for tasks created before this column existed.
  schedulingAnchor DateTime?

  scheduledStartTime DateTime? // assigned by the EDF engine

  // Calendar view active when the task was created. For a flexible task with NO
  // deadline this bounds placement to the working hours of the period (day /
  // ISO-week / month) containing `schedulingAnchor`: the task may not silently
  // roll past the end of that period — if it can't fit, it stays unplaced and
  // the create response carries the overflow recovery options. Null for fixed
  // tasks and rows created before this column existed (legacy → unbounded).
  view ViewMode?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-user labels (implicit many-to-many).
  tags Tag[]

  events TaskEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, deadline])
  @@index([userId, status])
  @@index([userId, scheduledStartTime])
}

enum TaskEventType {
  CREATE
  MOVE // user dragged to another slot/day — also serves as the "rescheduled" outcome
  RESIZE
  KEEP // user left an EDF suggestion in place (completed in its suggested slot) — positive signal
  COMPLETE // outcome: completed in its slot
  ABANDON // outcome: deadline expired unresolved (emitted by the overdue sweep)
}

model TaskEvent {
  id          BigInt        @id @default(autoincrement())
  eventType   TaskEventType
  oldSnapshot Json? // { scheduledStartTime, durationMinutes }; null on CREATE
  newSnapshot Json
  rewardScore Float         @default(1.0) // Phase-3 signal
  occurredAt  DateTime      @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String // denormalized for partition/range queries
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([taskId])
}

model File {
  id           String   @id @default(uuid())
  originalName String
  filename     String
  path         String
  mimetype     String
  size         Int
  userId       String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

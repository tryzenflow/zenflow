generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(30)
  email     String   @unique @db.VarChar(30)
  createdAt DateTime @default(now())
  timezone  String   @db.VarChar(50)

  // Relations
  tasks       Task[]
  categories  Category[]
  constraints Constraints?
}

model Task {
  id       String @id @default(uuid())
  title    String
  duration Int
  priority Int    @default(3) // 1–3 (lower = more important)

  fixedStart    Int?      @db.SmallInt // minutes since midnight
  earliestStart Int?      @db.SmallInt
  latestEnd     Int?      @db.SmallInt
  deadline      DateTime?

  mandatory   Boolean @default(true)
  splittable  Boolean @default(false)
  maxSplits   Int     @default(1)
  energyLevel Int     @default(1) // 1–3

  userId     String
  categoryId String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  schedules Schedule[]

  createdAt DateTime @default(now())

  // relations
  prerequisites Task[] @relation("TaskPrerequisites")
  dependentOn   Task[] @relation("TaskPrerequisites")
}

model Schedule {
  date  DateTime @db.Date
  start DateTime
  end   DateTime
  split Int      @db.SmallInt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, split, date])
}

model Constraints {
  minGapBetweenTasks Int     @default(0)
  maxDailyLoad       Int     @default(1440)
  batchSimilarTasks  Boolean @default(true)
  id                 String  @id
  user               User    @relation(fields: [id], references: [id], onDelete: Cascade)

  availableHours AvailableHour[]
  energyBlocks   EnergyBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AvailableHour {
  id    String @id @default(uuid())
  start Int    @db.SmallInt // minutes since midnight
  end   Int    @db.SmallInt

  constraints   Constraints @relation(fields: [constraintsId], references: [id])
  constraintsId String
}

model EnergyBlock {
  id          String @id @default(uuid())
  energyLevel Int    @db.SmallInt // 1–3
  start       Int    @db.SmallInt
  end         Int    @db.SmallInt

  constraints   Constraints @relation(fields: [constraintsId], references: [id])
  constraintsId String
}

model Category {
  id     String @id @default(uuid())
  name   String
  userId String

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name])
}

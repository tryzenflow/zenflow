{
  "uid": "zenflow-scheduler-bandit",
  "title": "Zenflow · Scheduler & Bandit",
  "tags": [
    "zenflow",
    "scheduler",
    "bandit"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Which placement method is used (A/B)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Suggested slots per second, by policy",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (policy) (rate(scheduler_proposals_total[$__rate_interval]))",
          "legendFormat": "{{policy}}"
        }
      ],
      "description": "New time-slot suggestions written per second, split by the placement method assigned to the user: the rule-based heuristic or the learned model. Both should receive traffic while the experiment runs."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Suggested slots per second, by trigger",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (trigger) (rate(scheduler_proposals_total[$__rate_interval]))",
          "legendFormat": "{{trigger}}"
        }
      ],
      "description": "The same suggestions split by what caused the placement (for example a new task or a change to an existing one). A jump here explains a jump in load on the placement service."
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Method actually used (selected range)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (applied) (increase(scheduler_applied_policy_total[$__range]))",
          "legendFormat": "{{applied}}"
        }
      ],
      "description": "Share of placements by the method that produced the final slot. It differs from the assigned policy when the learned model could not answer and the heuristic took over."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Learned-model fallbacks per second, by reason",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(scheduler_bandit_fallback_total[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "description": "How often a placement fell back to the heuristic because the learned model could not answer, and why. Anything above a trickle means the learning service is struggling."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Fallback rate (selected range)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(scheduler_bandit_fallback_total[$__range])) / clamp_min(sum(increase(scheduler_proposals_total[$__range])), 1)"
        }
      ],
      "description": "Fallbacks divided by all suggestions over the selected time range. Healthy is close to 0%; an alert fires above 20% for 15 minutes."
    },
    {
      "id": 7,
      "type": "row",
      "title": "Placement time",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Placement time, whole request",
      "description": "How long placing one task takes, from the API's point of view. Three nested views, each wider than the last: the placement service's own time, the same call including the network round trip, and the whole placement including reading data and saving the result. p50 is the typical request, p95 is the slow end.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum(rate(scheduler_placement_duration_seconds_bucket{source=\"python\"}[$__rate_interval])) by (le))",
          "legendFormat": "Whole placement, typical (p50)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(scheduler_placement_duration_seconds_bucket{source=\"python\"}[$__rate_interval])) by (le))",
          "legendFormat": "Whole placement, slow (p95)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=\"http\"}[$__rate_interval])) by (le))",
          "legendFormat": "Placement service call incl. network (p95)"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=\"total\"}[$__rate_interval])) by (le))",
          "legendFormat": "Placement service only (p95)"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Placement time, step by step (p95)",
      "description": "Where the placement service spends its time (slow end, p95). Read request: parse and validate the incoming request. Build context: compute the features describing each candidate day. Score options: the learned model scores every option (the extra cost of the model). Search slots: find the best free slot among the candidates. Resolve conflicts: only runs when no slot is free and other sessions have to be moved around, so it is usually empty.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "decode"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Read request"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "context"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Build context"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "predict"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Score options"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "scan"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Search slots"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "displace"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Resolve conflicts"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=~\"decode|context|predict|scan|displace\"}[$__rate_interval])))",
          "legendFormat": "{{phase}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "table",
      "title": "Placement time by policy (selected range)",
      "description": "Per assigned policy over the selected time range: number of placements, typical and slow placement-service time, and the same call including network. 'Ran both methods' means the heuristic and the learned model were both computed for the same request so they can be compared; while that is on for every request, the policies show near-identical numbers.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*\\(s\\)/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "placements"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (assigned, compute_both) (increase(scheduler_placement_python_duration_seconds_count{mode=\"PLACE\",phase=\"total\"}[$__range]))"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, assigned, compute_both) (rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=\"total\"}[$__range])))"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, assigned, compute_both) (rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=\"total\"}[$__range])))"
        },
        {
          "refId": "D",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, assigned, compute_both) (rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=\"http\"}[$__range])))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "assigned": "assigned policy",
              "compute_both": "ran both methods",
              "Value #A": "placements",
              "Value #B": "p50 (s)",
              "Value #C": "p95 (s)",
              "Value #D": "round trip p95 (s)"
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Learning signals",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      }
    },
    {
      "id": 11,
      "type": "piechart",
      "title": "Arm chosen by time of day (selected range)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "pieType": "pie",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (arm) (increase(scheduler_bandit_arm_selected_total[$__range]))",
          "legendFormat": "{{arm}}"
        }
      ],
      "description": "Which time-of-day option the learned model picked, as a share of all picks. A heavily lopsided split can mean it has not learned enough yet."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Session events per second, by type",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (type) (rate(scheduler_session_events_total[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ],
      "description": "User actions on sessions (create, move, resize and so on) per second. These are the raw signal the model learns from."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Learning updates per second, by source and result",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source, result) (rate(scheduler_reward_updates_total[$__rate_interval]))",
          "legendFormat": "{{source}} · {{result}}"
        }
      ],
      "description": "How often the model was updated from a user action, by where the update came from and whether it succeeded. Failures here mean actions are not being learned from."
    },
    {
      "id": 14,
      "type": "heatmap",
      "title": "How far users drag sessions (minutes)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "scheme": "Oranges",
          "mode": "scheme"
        },
        "yAxis": {
          "unit": "m"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "heatmap",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase({__name__=~\"scheduler_session_move_drag_minutes(_minutes)?_bucket\"}[$__rate_interval]))",
          "legendFormat": "{{le}}"
        }
      ],
      "description": "Distribution of how far users move a session away from the suggested time. Large drags mean the suggestions are being corrected a lot."
    },
    {
      "id": 30,
      "type": "row",
      "title": "Learning service",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 52
      }
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Scoring failures (selected range)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 16,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(bandit_singular_matrix_total[$__range]))"
        }
      ],
      "description": "Times the learned model could not score options because its internal matrix was unusable. Each one forces a heuristic fallback. Healthy is 0."
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Options still learning, per placement (average)",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 6,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(bandit_linucb_cold_arms_sum[$__rate_interval])) / clamp_min(sum(rate(bandit_linucb_cold_arms_count[$__rate_interval])), 0.001)",
          "legendFormat": "cold arms"
        }
      ],
      "description": "On average, how many of the 6 time-of-day options have no learned data yet and rely on the default starting guess. It falls as the model sees more actions."
    },
    {
      "id": 35,
      "type": "timeseries",

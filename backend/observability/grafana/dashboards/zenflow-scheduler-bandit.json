{
  "uid": "zenflow-scheduler-bandit",
  "title": "Zenflow · Scheduler & Bandit",
  "tags": ["zenflow", "scheduler", "bandit"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "links": [],
  "templating": { "list": [] },
  "panels": [
    { "id": 1, "type": "row", "title": "Placement decisions (A/B)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2, "type": "timeseries", "title": "Proposals/s by policy",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (policy) (rate(scheduler_proposals_total[$__rate_interval]))", "legendFormat": "{{policy}}" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Proposals/s by trigger",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (trigger) (rate(scheduler_proposals_total[$__rate_interval]))", "legendFormat": "{{trigger}}" } ]
    },
    {
      "id": 4, "type": "piechart", "title": "Applied policy split (range)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (applied) (increase(scheduler_applied_policy_total[$__range]))", "legendFormat": "{{applied}}" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Bandit fallback/s by reason",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (reason) (rate(scheduler_bandit_fallback_total[$__rate_interval]))", "legendFormat": "{{reason}}" } ]
    },
    {
      "id": 6, "type": "stat", "title": "Fallback rate (fallbacks ÷ proposals, range)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.3 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(scheduler_bandit_fallback_total[$__range])) / clamp_min(sum(increase(scheduler_proposals_total[$__range])), 1)" } ]
    },

    { "id": 7, "type": "row", "title": "Placement latency — heuristic vs LinUCB", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 } },
    {
      "id": 8, "type": "timeseries", "title": "End-to-end single placement p50 / p95 by assigned policy",
      "description": "Whole single-TASK placement: gather + Python /v1/place + apply + persist. \"assigned\" is the A/B roll. While PAIRWISE_SAMPLE_RATE=1 both algorithms run on every request, so the two lines are expected to match; set it to 0 to see each policy on its own.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "/.*/" }, "properties": [ { "id": "unit", "value": "s" } ] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.5, sum by (le, assigned) (rate(scheduler_placement_duration_seconds_bucket{source=\"python\"}[$__rate_interval])))", "legendFormat": "p50 · {{assigned}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, assigned) (rate(scheduler_placement_duration_seconds_bucket{source=\"python\"}[$__rate_interval])))", "legendFormat": "p95 · {{assigned}}" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Python /v1/place total p95 by assigned policy · compute_both",
      "description": "Service-reported time (total) vs API-side round trip (http). compute_both=true means Python ran the heuristic AND LinUCB for that request. PREFLIGHT calls are excluded (always heuristic).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "/.*/" }, "properties": [ { "id": "unit", "value": "s" } ] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, assigned, compute_both) (rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=\"total\"}[$__rate_interval])))", "legendFormat": "{{assigned}} · both={{compute_both}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, assigned, compute_both) (rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=\"http\"}[$__rate_interval])))", "legendFormat": "round trip · {{assigned}} · both={{compute_both}}" }
      ]
    },
    {
      "id": 15, "type": "timeseries", "title": "Python phase p95: scan · predict · context · decode · displace",
      "description": "scan = slot search, predict = LinUCB scoring (the extra cost of the bandit), context = request context build.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "/.*/" }, "properties": [ { "id": "unit", "value": "s" } ] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, phase, assigned, compute_both) (rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=~\"scan|predict|context|decode|displace\"}[$__rate_interval])))", "legendFormat": "{{phase}} · {{assigned}} · both={{compute_both}}" }
      ]
    },
    {
      "id": 16, "type": "table", "title": "Latency by policy (range)",
      "description": "Placements and Python /v1/place latency per assigned policy and compute_both, mode=PLACE only.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "/.*\\(s\\)/" }, "properties": [ { "id": "unit", "value": "s" } ] },
        { "matcher": { "id": "byName", "options": "placements" }, "properties": [ { "id": "decimals", "value": 0 } ] }
      ] },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (assigned, compute_both) (increase(scheduler_placement_python_duration_seconds_count{mode=\"PLACE\",phase=\"total\"}[$__range]))" },
        { "refId": "B", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.5, sum by (le, assigned, compute_both) (rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=\"total\"}[$__range])))" },
        { "refId": "C", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, assigned, compute_both) (rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=\"total\"}[$__range])))" },
        { "refId": "D", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, assigned, compute_both) (rate(scheduler_placement_python_duration_seconds_bucket{mode=\"PLACE\",phase=\"http\"}[$__range])))" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true },
          "renameByName": { "assigned": "assigned policy", "compute_both": "both computed", "Value #A": "placements", "Value #B": "p50 (s)", "Value #C": "p95 (s)", "Value #D": "round trip p95 (s)" }
        } }
      ]
    },
    { "id": 10, "type": "row", "title": "Arms, rewards, session events", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 } },
    {
      "id": 11, "type": "piechart", "title": "Time-of-day arm selection (range)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "pieType": "pie", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (arm) (increase(scheduler_bandit_arm_selected_total[$__range]))", "legendFormat": "{{arm}}" } ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Session events/s by type",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (type) (rate(scheduler_session_events_total[$__rate_interval]))", "legendFormat": "{{type}}" } ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Reward updates/s by source · result",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (source, result) (rate(scheduler_reward_updates_total[$__rate_interval]))", "legendFormat": "{{source}} · {{result}}" } ]
    },
    {
      "id": 14, "type": "heatmap", "title": "User MOVE drag distance (minutes)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 43 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "m", "custom": { "hideFrom": { "tooltip": false, "viz": false, "legend": false } } }, "overrides": [] },
      "options": { "calculate": false, "cellGap": 1, "color": { "scheme": "Oranges", "mode": "scheme" }, "yAxis": { "unit": "m" }, "legend": { "show": true }, "tooltip": { "mode": "single", "yHistogram": true } },
      "targets": [ { "refId": "A", "format": "heatmap", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (le) (increase({__name__=~\"scheduler_session_move_drag_minutes(_minutes)?_bucket\"}[$__rate_interval]))", "legendFormat": "{{le}}" } ]
    },

    { "id": 20, "type": "row", "title": "Cron / watcher handlers", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 } },
    {
      "id": 21, "type": "table", "title": "Cron runs (range) — ok vs error",
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 53 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } ] }
      ] },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "job", "desc": false } ] },
      "targets": [
        { "refId": "A", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (job) (increase(scheduler_cron_runs_total{result=\"ok\"}[$__range]))" },
        { "refId": "B", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (job) (increase(scheduler_cron_runs_total{result=\"error\"}[$__range]))" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "renameByName": { "job": "job", "Value #A": "ok", "Value #B": "error" }, "excludeByName": { "Time": true } } }
      ]
    },
    {
      "id": 22, "type": "timeseries", "title": "Cron duration p95 by job",
      "gridPos": { "h": 8, "w": 14, "x": 10, "y": 53 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, job) (rate({__name__=~\"scheduler_cron_duration_seconds_bucket\"}[$__rate_interval])))", "legendFormat": "{{job}}" } ]
    },

    { "id": 30, "type": "row", "title": "Bandit service (Python / LinUCB)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 61 } },
    {
      "id": 32, "type": "timeseries", "title": "/update latency p95",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(bandit_update_duration_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p95" } ]
    },
    {
      "id": 33, "type": "stat", "title": "Singular-matrix failures (range)",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(bandit_singular_matrix_total[$__range]))" } ]
    },
    {
      "id": 34, "type": "timeseries", "title": "Cold arms per LinUCB placement (avg)",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 6, "custom": { "drawStyle": "line", "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(bandit_linucb_cold_arms_sum[$__rate_interval])) / clamp_min(sum(rate(bandit_linucb_cold_arms_count[$__rate_interval])), 0.001)", "legendFormat": "cold arms" } ]
    },
    {
      "id": 35, "type": "timeseries", "title": "Bandit client (API → service) rate & p95",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 70 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "/p95.*/" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" } ] },
        { "matcher": { "id": "byRegexp", "options": "/rate.*/" }, "properties": [ { "id": "unit", "value": "reqps" } ] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (operation) (rate(bandit_client_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "rate · {{operation}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(bandit_client_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 · {{operation}}" }
      ]
    }
  ]
}

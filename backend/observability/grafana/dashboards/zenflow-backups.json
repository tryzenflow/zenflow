    {
      "id": 9,
      "type": "logs",
      "title": "Backup problems",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"backup\"} |~ \"(?i)error|warn|fail|denied|not authorized|unable|no such|upload failed\"",
          "queryType": "range"
        }
      ],
      "description": "Only the error lines from the backup container (this is the AccessDenied message from S3, the failing step, restore mismatches)."
    },

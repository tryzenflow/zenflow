{
  "name": "zenflow",
  "private": true,
  "version": "2.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "shared:build": "pnpm --filter @zenflow/shared build",
    "core:build": "pnpm --filter @zenflow/core build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@nestjs/core",
      "unrs-resolver",
      "@scarf/scarf"
    ],
    "overrides": {
      "sharp": "0.32.6",
      "sharp-ico": "0.1.5",
      "jest-environment-node": "30.4.1",
      "@types/react": "19.1.17",
      "lightningcss": "1.30.1"
    },
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "*"
        },
        "peerDependenciesMeta": {
          "zod": {
            "optional": true
          }
        }
      }
    }
  }
}

{
  "name": "zenflow",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "shared:build": "pnpm --filter @zenflow/shared build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@nestjs/core",
      "unrs-resolver",
      "@scarf/scarf"
    ],
    "overrides": {
      "sharp": "0.32.6",
      "sharp-ico": "0.1.5"
    }
  }
}

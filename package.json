{
  "name": "zenflow",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "backend:dev": "pnpm --filter backend start:dev",
    "backend:prod": "pnpm --filter backend start:prod",
    "frontend:dev": "pnpm --filter frontend dev",
    "frontend:prod": "pnpm --filter frontend start",
    "mobile:dev": "pnpm --filter mobile dev",
    "shared:build": "pnpm --filter @zenflow/shared build",
    "core:build": "pnpm --filter @zenflow/core build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@nestjs/core",
      "unrs-resolver",
      "@scarf/scarf"
    ],
    "overrides": {
      "sharp": "0.32.6",
      "sharp-ico": "0.1.5",
      "jest-environment-node": "30.4.1"
    }
  }
}
